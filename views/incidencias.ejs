            </div>
            <div class="filter-pills">
                <span class="pill active" onclick="setPill(this,'all')">Todos</span>
                <span class="pill" onclick="setPill(this,'unassigned')">Sin asignar</span>
                <span class="pill" onclick="setPill(this,'mine')">Mis tickets</span>
