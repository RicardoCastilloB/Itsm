               style="padding:8px 12px;border-radius:8px;border:1px solid var(--border-soft);background:var(--bg-main);color:var(--text-main);font-size:13px;">
        <select id="pmqSeverity" style="padding:8px 10px;border-radius:8px;border:1px solid var(--border-soft);background:var(--bg-main);color:var(--text-main);font-size:13px;">
          <option value="critical">🔴 Crítico</option>
          <option value="warning" selected>🟡 Advertencia</option>
          <option value="info">🔵 Informativo</option>
          <option value="success">🟢 Resuelto</option>
        </select>
        <button onclick="pmqSubmit()" style="padding:8px 18px;border-radius:8px;border:none;background:#ea580c;color:#fff;font-size:13px;font-weight:700;cursor:pointer;display:flex;align-items:center;gap:6px;white-space:nowrap;"><i class="bi bi-send-fill"></i> Publicar</button>
      </div>
      <div style="display:flex;align-items:center;gap:8px;">
        <input type="datetime-local" id="pmqExpires"
               style="padding:7px 10px;border-radius:8px;border:1px solid var(--border-soft);background:var(--bg-main);color:var(--text-main);font-size:12px;flex:1;max-width:240px;">
        <span style="font-size:11px;color:var(--text-muted);">Fecha de expiración (opcional — deja vacío para indefinido)</span>
      </div>
    </div>

    <!-- Lista activos -->
    <div style="background:var(--bg-card);border:1px solid var(--border-soft);border-radius:12px;overflow:hidden;">
      <div style="padding:12px 16px;border-bottom:1px solid var(--border-soft);font-size:12px;font-weight:700;color:var(--text-main);display:flex;align-items:center;justify-content:space-between;">
        <span><i class="bi bi-list-ul"></i> Avisos activos</span>
        <button onclick="pmqLoadList()" style="padding:4px 10px;border-radius:6px;border:1px solid var(--border-soft);background:transparent;color:var(--text-muted);font-size:11px;cursor:pointer;"><i class="bi bi-arrow-clockwise"></i> Actualizar</button>
      </div>
      <div id="pmqList" style="padding:8px 12px;display:flex;flex-direction:column;gap:8px;min-height:60px;">
        <div style="text-align:center;padding:20px;color:var(--text-muted);font-size:13px;"><i class="bi bi-hourglass-split"></i> Cargando...</div>
      </div>
    </div>
  </div>
</div>

<!-- ══ TAB: Preguntas de Usuarios (Portal) ══ -->
<div id="tabPreguntas" class="corp-tabpanel" style="display:none;">
  <div style="display:flex;align-items:center;justify-content:space-between;flex-wrap:wrap;gap:12px;margin-bottom:20px;">
    <div>
      <div style="font-size:17px;font-weight:700;color:var(--text-main);display:flex;align-items:center;gap:8px;">
        <i class="bi bi-chat-dots-fill" style="color:var(--jira-blue)"></i> Preguntas de Usuarios del Portal
      </div>
      <div style="font-size:12px;color:var(--text-muted);">Responde y publica en la base de conocimiento (FAQ).</div>
    </div>
    <div style="display:flex;gap:8px;align-items:center;flex-wrap:wrap;">
      <select id="pqFilter" onchange="loadUserQuestions()" style="font-size:13px;border-radius:8px;border:1px solid var(--border-soft);background:var(--bg-card);color:var(--text-main);padding:7px 10px;">
        <option value="">Todas</option>
        <option value="pending">Pendientes</option>
        <option value="answered">Respondidas</option>
        <option value="published">Publicadas en FAQ</option>
      </select>
      <button onclick="loadUserQuestions()" style="padding:7px 14px;border-radius:8px;border:1px solid var(--border-soft);background:var(--bg-card);color:var(--text-main);font-size:13px;cursor:pointer;display:flex;align-items:center;gap:5px;"><i class="bi bi-arrow-clockwise"></i> Actualizar</button>
    </div>
  </div>

  <div id="pqList" style="display:flex;flex-direction:column;gap:12px;">
    <div style="text-align:center;padding:40px;color:var(--text-muted);"><i class="bi bi-hourglass-split" style="font-size:28px;opacity:.4;"></i><br>Cargando…</div>
  </div>

  <!-- CONTRIBUTIONS SUB-SECTION -->
  <div style="margin-top:40px;padding-top:28px;border-top:2px dashed var(--border-soft);">
    <div style="display:flex;align-items:center;justify-content:space-between;flex-wrap:wrap;gap:10px;margin-bottom:16px;">
      <div>
        <div style="font-size:17px;font-weight:700;color:var(--text-main);display:flex;align-items:center;gap:8px;">
          <i class="bi bi-lightbulb-fill" style="color:#f59e0b"></i> Conocimiento Compartido por Usuarios
        </div>
        <div style="font-size:12px;color:var(--text-muted);">Aprueba los aportes para que aparezcan públicamente en la base de conocimiento.</div>
      </div>
      <div style="display:flex;gap:8px;align-items:center;flex-wrap:wrap;">
        <select id="ctFilter" onchange="loadAdminContribs()" style="font-size:13px;border-radius:8px;border:1px solid var(--border-soft);background:var(--bg-card);color:var(--text-main);padding:7px 10px;">
          <option value="">Todos</option>
          <option value="pending">Pendientes</option>
          <option value="approved">Aprobados</option>
          <option value="rejected">Rechazados</option>
        </select>
        <button onclick="loadAdminContribs()" style="padding:7px 14px;border-radius:8px;border:1px solid var(--border-soft);background:var(--bg-card);color:var(--text-main);font-size:13px;cursor:pointer;display:flex;align-items:center;gap:5px;"><i class="bi bi-arrow-clockwise"></i> Actualizar</button>
      </div>
    </div>
    <div id="ctAdminList" style="display:flex;flex-direction:column;gap:10px;">
      <div style="text-align:center;padding:30px;color:var(--text-muted);"><i class="bi bi-hourglass-split" style="font-size:24px;opacity:.4;"></i><br>Cargando…</div>
    </div>
  </div>

  <!-- WHATSAPP: ver pestaña dedicada -->
  <div style="margin-top:28px;padding:14px 18px;background:#f0fdf4;border:1px solid #bbf7d0;border-radius:10px;display:flex;align-items:center;gap:10px;">
    <i class="bi bi-whatsapp" style="color:#25d366;font-size:18px;"></i>
    <span style="font-size:13px;color:#064e3b;">Las solicitudes de WhatsApp Bot están en la pestaña <strong>WhatsApp Bot</strong>.</span>
    <button onclick="doTab('whatsapp',document.getElementById('tabBtnWhatsapp'));loadWspRequests()" style="margin-left:auto;padding:6px 14px;border-radius:7px;border:none;background:#25d366;color:#fff;font-size:12px;font-weight:700;cursor:pointer;">
      <i class="bi bi-arrow-right"></i> Ir ahora
    </button>
  </div>

  <!-- ANSWER MODAL -->
  <div id="pqAnswerModal" style="display:none;position:fixed;inset:0;background:rgba(0,0,0,.5);z-index:9000;align-items:center;justify-content:center;">
    <div style="background:var(--bg-card);border-radius:16px;padding:28px;width:100%;max-width:580px;max-height:90vh;overflow-y:auto;box-shadow:0 8px 40px rgba(0,0,0,.25);">
      <div style="display:flex;align-items:center;justify-content:space-between;margin-bottom:18px;">
        <div style="font-size:16px;font-weight:700;color:var(--text-main);display:flex;align-items:center;gap:8px;"><i class="bi bi-reply-fill" style="color:var(--jira-blue)"></i> Responder Pregunta</div>
        <button onclick="closePqModal()" style="background:none;border:none;cursor:pointer;font-size:20px;color:var(--text-muted);">×</button>
      </div>
      <input type="hidden" id="pqAnswerId">
      <div style="font-size:11px;font-weight:700;color:var(--text-muted);text-transform:uppercase;letter-spacing:.5px;margin-bottom:6px;">Pregunta del usuario</div>
      <div id="pqAnswerQuestion" style="background:var(--bg);border:1px solid var(--border-soft);border-radius:10px;padding:12px 14px;font-size:13px;color:var(--text-main);margin-bottom:16px;line-height:1.6;"></div>
      <div style="font-size:11px;font-weight:700;color:var(--text-muted);text-transform:uppercase;letter-spacing:.5px;margin-bottom:6px;">Categoría</div>
      <select id="pqAnswerCat" style="width:100%;border:1.5px solid var(--border-soft);border-radius:8px;padding:9px 12px;font-size:13px;background:var(--bg);color:var(--text-main);margin-bottom:14px;outline:none;">
        <option value="General">General</option>
        <option value="Incidencias">Incidencias</option>
        <option value="Requerimientos">Requerimientos</option>
        <option value="Equipos y Mantenimiento">Equipos y Mantenimiento</option>
        <option value="Accesos y Correo">Accesos y Correo</option>
      </select>
      <div style="font-size:11px;font-weight:700;color:var(--text-muted);text-transform:uppercase;letter-spacing:.5px;margin-bottom:6px;">Tu respuesta *</div>
      <textarea id="pqAnswerText" rows="6" placeholder="Escribe la respuesta detallada…" style="width:100%;border:1.5px solid var(--border-soft);border-radius:10px;padding:11px 14px;font-size:13px;background:var(--bg);color:var(--text-main);outline:none;resize:vertical;font-family:inherit;margin-bottom:20px;"></textarea>
      <div style="display:flex;gap:10px;justify-content:flex-end;">
        <button onclick="closePqModal()" style="padding:9px 20px;border-radius:8px;border:1px solid var(--border-soft);background:var(--bg-card);color:var(--text-main);font-size:13px;font-weight:600;cursor:pointer;">Cancelar</button>
        <button onclick="savePqAnswer()" style="padding:9px 20px;border-radius:8px;border:none;background:var(--jira-blue);color:#fff;font-size:13px;font-weight:700;cursor:pointer;display:flex;align-items:center;gap:6px;"><i class="bi bi-check-lg"></i> Guardar respuesta</button>
        <button onclick="savePqAnswer(true)" style="padding:9px 20px;border-radius:8px;border:none;background:#059669;color:#fff;font-size:13px;font-weight:700;cursor:pointer;display:flex;align-items:center;gap:6px;"><i class="bi bi-book-fill"></i> Guardar y publicar en FAQ</button>
      </div>
    </div>
  </div>
</div>

<script>
// ── USER QUESTIONS (PORTAL) ───────────────────────────────────────────────────
const PQ_STATUS_LABEL = { pending:'Pendiente', answered:'Respondida', published:'Publicada en FAQ' };
const PQ_STATUS_COLOR = { pending:'#f59e0b', answered:'#3b82f6', published:'#059669' };

async function loadUserQuestions(){
  const status = document.getElementById('pqFilter')?.value || '';
  const url = '/api/portal/questions' + (status ? '?status='+status : '');
  const r = await fetch(url, { credentials:'include' });
  const d = await r.json();
  const list = document.getElementById('pqList');
  if (!d.success || !d.data.length) {
    list.innerHTML = '<div style="text-align:center;padding:40px;color:var(--text-muted);"><i class="bi bi-inbox" style="font-size:32px;opacity:.3;display:block;margin-bottom:8px;"></i>No hay preguntas registradas.</div>';
    return;
  }
  list.innerHTML = d.data.map(q => `
    <div style="background:var(--bg-card);border:1px solid var(--border-soft);border-radius:12px;padding:18px 20px;">
      <div style="display:flex;align-items:flex-start;justify-content:space-between;gap:12px;flex-wrap:wrap;">
        <div style="flex:1;min-width:0;">
          <div style="display:flex;align-items:center;gap:8px;margin-bottom:8px;flex-wrap:wrap;">
            <span style="font-size:11px;font-weight:700;background:rgba(99,102,241,.08);color:#6366f1;border:1px solid rgba(99,102,241,.2);border-radius:6px;padding:2px 9px;">${escHtmlPq(q.category||'General')}</span>
            <span style="font-size:11px;font-weight:700;color:${PQ_STATUS_COLOR[q.status]||'#94a3b8'};background:${PQ_STATUS_COLOR[q.status]||'#94a3b8'}18;border-radius:6px;padding:2px 9px;">${PQ_STATUS_LABEL[q.status]||q.status}</span>
            <span style="font-size:11px;color:var(--text-muted);">${escHtmlPq(q.name||q.email)} · ${new Date(q.created_at).toLocaleDateString('es-PE')}</span>
          </div>
          <div style="font-size:14px;font-weight:600;color:var(--text-main);margin-bottom:${q.answer?'10px':'0'};">${escHtmlPq(q.question)}</div>
          ${q.answer ? `<div style="font-size:13px;color:var(--text-muted);background:var(--bg);border-left:3px solid var(--jira-blue);border-radius:0 8px 8px 0;padding:10px 12px;margin-top:8px;line-height:1.6;">${escHtmlPq(q.answer)}</div>` : ''}
        </div>
        <div style="display:flex;flex-direction:column;gap:6px;flex-shrink:0;">
          ${q.status !== 'published' ? `<button onclick="openPqAnswer(${q.id},'${escHtmlPq(q.question).replace(/'/g,"\\'")}','${escHtmlPq(q.answer||'').replace(/'/g,"\\'")}','${escHtmlPq(q.category||'General')}')" style="padding:6px 14px;border-radius:8px;border:1px solid var(--jira-blue);background:rgba(37,99,235,.07);color:var(--jira-blue);font-size:12px;font-weight:700;cursor:pointer;white-space:nowrap;"><i class="bi bi-reply-fill"></i> Responder</button>` : ''}
          ${q.status === 'answered' ? `<button onclick="publishPq(${q.id})" style="padding:6px 14px;border-radius:8px;border:1px solid #059669;background:rgba(5,150,105,.07);color:#059669;font-size:12px;font-weight:700;cursor:pointer;white-space:nowrap;"><i class="bi bi-book-fill"></i> Publicar en FAQ</button>` : ''}
          <button onclick="deletePq(${q.id})" style="padding:6px 14px;border-radius:8px;border:1px solid #fca5a5;background:rgba(239,68,68,.07);color:#dc2626;font-size:12px;font-weight:700;cursor:pointer;"><i class="bi bi-trash3"></i></button>
        </div>
      </div>
    </div>
  `).join('');
}

function escHtmlPq(s){ return String(s||'').replace(/&/g,'&amp;').replace(/</g,'&lt;').replace(/>/g,'&gt;').replace(/"/g,'&quot;'); }

function openPqAnswer(id, question, answer, category){
  document.getElementById('pqAnswerId').value = id;
  document.getElementById('pqAnswerQuestion').textContent = question;
  document.getElementById('pqAnswerText').value = answer || '';
  const sel = document.getElementById('pqAnswerCat');
  if (sel) sel.value = category || 'General';
  const modal = document.getElementById('pqAnswerModal');
  modal.style.display = 'flex';
}
function closePqModal(){ document.getElementById('pqAnswerModal').style.display='none'; }
document.getElementById('pqAnswerModal').addEventListener('click', e => { if(e.target===e.currentTarget) closePqModal(); });

async function savePqAnswer(andPublish){
  const id     = document.getElementById('pqAnswerId').value;
  const answer = document.getElementById('pqAnswerText').value.trim();
  const category = document.getElementById('pqAnswerCat').value;
  if (!answer) { alert('Escribe la respuesta antes de guardar.'); return; }
  const r = await fetch('/api/portal/questions/'+id, {
    method:'PUT', credentials:'include', headers:{'Content-Type':'application/json'},
    body: JSON.stringify({ answer, category })
  });
  const d = await r.json();
  if (!d.success) { alert('Error: '+(d.error||'No se pudo guardar')); return; }
  if (andPublish) await publishPq(id);
  closePqModal();
  loadUserQuestions();
}

async function publishPq(id){
  const r = await fetch('/api/portal/questions/'+id+'/publish', {
    method:'POST', credentials:'include', headers:{'Content-Type':'application/json'}
  });
  const d = await r.json();
  if (!d.success) { alert('Error: '+(d.error||'No se pudo publicar')); return; }
  loadUserQuestions();
}

async function deletePq(id){
  if (!confirm('¿Eliminar esta pregunta?')) return;
  await fetch('/api/portal/questions/'+id, { method:'DELETE', credentials:'include' });
  loadUserQuestions();
}

// ── KNOWLEDGE CONTRIBUTIONS (admin panel) ────────────────────────────────────
const CT_STATUS_LABEL = { pending:'Pendiente revisión', approved:'Aprobado', rejected:'Rechazado' };
const CT_STATUS_COLOR = { pending:'#f59e0b', approved:'#059669', rejected:'#dc2626' };

async function loadAdminContribs(){
  const status = document.getElementById('ctFilter')?.value || '';
  const url = '/api/portal/contributions' + (status ? '?status='+status : '');
  const r = await fetch(url, { credentials:'include' });
  const d = await r.json();
  const list = document.getElementById('ctAdminList');
  if (!d.success || !d.data.length) {
    list.innerHTML = '<div style="text-align:center;padding:30px;color:var(--text-muted);"><i class="bi bi-inbox" style="font-size:28px;opacity:.3;display:block;margin-bottom:6px;"></i>No hay aportes registrados.</div>';
    return;
  }
  list.innerHTML = d.data.map(c => `
    <div style="background:var(--bg-card);border:1px solid var(--border-soft);border-radius:12px;padding:16px 18px;">
      <div style="display:flex;align-items:flex-start;justify-content:space-between;gap:12px;flex-wrap:wrap;">
        <div style="flex:1;min-width:0;">
          <div style="display:flex;align-items:center;gap:8px;margin-bottom:8px;flex-wrap:wrap;">
            <span style="font-size:11px;font-weight:700;background:rgba(245,158,11,.1);color:#b45309;border:1px solid rgba(245,158,11,.2);border-radius:6px;padding:2px 9px;">${escHtmlPq(c.category||'General')}</span>
            <span style="font-size:11px;font-weight:700;color:${CT_STATUS_COLOR[c.status]||'#94a3b8'};background:${CT_STATUS_COLOR[c.status]||'#94a3b8'}18;border-radius:6px;padding:2px 9px;">${CT_STATUS_LABEL[c.status]||c.status}</span>
            <span style="font-size:11px;color:var(--text-muted);">${escHtmlPq(c.name||c.email)} · ${new Date(c.created_at).toLocaleDateString('es-PE')}</span>
          </div>
          <div style="font-size:14px;font-weight:700;color:var(--text-main);margin-bottom:6px;">${escHtmlPq(c.title)}</div>
          <div style="font-size:13px;color:var(--text-muted);line-height:1.6;white-space:pre-line;">${escHtmlPq(c.body)}</div>
          ${c.avg_stars > 0 ? `<div style="margin-top:8px;font-size:12px;color:#f59e0b;font-weight:600;">★ ${Number(c.avg_stars).toFixed(1)} (${c.rating_count} valoraciones)</div>` : ''}
        </div>
        <div style="display:flex;flex-direction:column;gap:6px;flex-shrink:0;">
          ${c.status !== 'approved' ? `<button onclick="approveContrib(${c.id})" style="padding:6px 14px;border-radius:8px;border:1px solid #059669;background:rgba(5,150,105,.08);color:#059669;font-size:12px;font-weight:700;cursor:pointer;white-space:nowrap;"><i class="bi bi-check-circle-fill"></i> Aprobar</button>` : ''}
          ${c.status !== 'rejected' ? `<button onclick="rejectContrib(${c.id})" style="padding:6px 14px;border-radius:8px;border:1px solid #f59e0b;background:rgba(245,158,11,.08);color:#b45309;font-size:12px;font-weight:700;cursor:pointer;white-space:nowrap;"><i class="bi bi-x-circle"></i> Rechazar</button>` : ''}
          <button onclick="deleteContrib(${c.id})" style="padding:6px 14px;border-radius:8px;border:1px solid #fca5a5;background:rgba(239,68,68,.07);color:#dc2626;font-size:12px;font-weight:700;cursor:pointer;"><i class="bi bi-trash3"></i></button>
        </div>
      </div>
    </div>
  `).join('');
}

async function approveContrib(id){
  const r = await fetch('/api/portal/contributions/'+id, {
    method:'PUT', credentials:'include', headers:{'Content-Type':'application/json'},
    body: JSON.stringify({ status:'approved' })
  });
  const d = await r.json();
  if (!d.success) alert('Error: '+(d.error||'No se pudo aprobar'));
  else loadAdminContribs();
}

async function rejectContrib(id){
  const r = await fetch('/api/portal/contributions/'+id, {
    method:'PUT', credentials:'include', headers:{'Content-Type':'application/json'},
    body: JSON.stringify({ status:'rejected' })
  });
  const d = await r.json();
  if (!d.success) alert('Error: '+(d.error||'No se pudo rechazar'));
  else loadAdminContribs();
}

async function deleteContrib(id){
  if (!confirm('¿Eliminar este aporte?')) return;
  await fetch('/api/portal/contributions/'+id, { method:'DELETE', credentials:'include' });
  loadAdminContribs();
}

// ── WHATSAPP REQUESTS ─────────────────────────────────────────────────────────
const WSP_STATUS_LABEL = { pending:'Pendiente', approved:'Aprobado', rejected:'Rechazado' };
const WSP_STATUS_COLOR = { pending:'#f59e0b', approved:'#25d366', rejected:'#dc2626' };

async function loadWspRequests(){
  const status = document.getElementById('wspFilter')?.value || '';
  const url = '/api/portal/whatsapp-requests' + (status ? '?status='+status : '');
  const list = document.getElementById('wspAdminList');
  if(!list) return;
  list.innerHTML = '<div style="text-align:center;padding:32px;color:var(--text-muted);font-size:13px;"><i class="bi bi-hourglass-split" style="font-size:26px;display:block;margin-bottom:8px;opacity:.4;"></i>Cargando...</div>';
  try {
    const r = await fetch(url, { credentials:'include' });
    const d = await r.json();
    if (!d.success || !d.data.length){
      list.innerHTML = '<div style="text-align:center;padding:40px;color:var(--text-muted);font-size:13px;"><i class="bi bi-inbox" style="font-size:32px;display:block;margin-bottom:8px;opacity:.3;"></i>No hay solicitudes registradas.</div>';
      return;
    }
    const pending = d.data.filter(function(w){ return w.status==='pending'; }).length;
    list.innerHTML = (pending > 0 ? `<div style="background:#fffbeb;border:1px solid #fde68a;border-radius:8px;padding:10px 16px;margin-bottom:0;font-size:12px;color:#92400e;display:flex;align-items:center;gap:8px;border-bottom-left-radius:0;border-bottom-right-radius:0;">
      <i class="bi bi-exclamation-triangle-fill" style="color:#f59e0b;"></i>
      <strong>${pending}</strong> solicitud${pending>1?'es':''} pendiente${pending>1?'s':''} de aprobación
    </div>` : '') +
    `<div style="overflow-x:auto;">
    <table class="table-tickets w-100" style="font-size:13px;">
      <thead><tr>
        <th style="padding:10px 14px;">Usuario</th>
        <th style="padding:10px 14px;">Correo</th>
        <th style="padding:10px 14px;text-align:center;">Número WhatsApp</th>
        <th style="padding:10px 14px;">Motivo</th>
        <th style="padding:10px 14px;white-space:nowrap;">Fecha</th>
        <th style="padding:10px 14px;text-align:center;">Estado</th>
        <th style="padding:10px 14px;text-align:center;">Acciones</th>
      </tr></thead>
      <tbody>${d.data.map(function(w){
        var sc = WSP_STATUS_COLOR[w.status]||'#94a3b8';
        var sl = WSP_STATUS_LABEL[w.status]||w.status;
        var fecha = w.created_at ? new Date(w.created_at).toLocaleDateString('es-PE',{day:'2-digit',month:'short',year:'numeric'}) : '—';
        return '<tr style="'+(w.status==='pending'?'background:#fffbeb;':'')+'">' +
          '<td style="padding:10px 14px;font-weight:600;">'+escHtmlPq(w.name||'—')+'</td>'+
          '<td style="padding:10px 14px;color:var(--text-muted);font-size:12px;">'+escHtmlPq(w.email||'—')+'</td>'+
          '<td style="padding:10px 14px;text-align:center;"><span style="font-size:15px;font-weight:800;color:#25d366;display:inline-flex;align-items:center;gap:5px;white-space:nowrap;"><i class="bi bi-whatsapp"></i>'+escHtmlPq(w.phone||'—')+'</span></td>'+
          '<td style="padding:10px 14px;color:var(--text-muted);font-size:12px;max-width:180px;">'+(w.reason?'<em>"'+escHtmlPq(w.reason)+'"</em>':'<span style="opacity:.4;">—</span>')+'</td>'+
          '<td style="padding:10px 14px;white-space:nowrap;color:var(--text-muted);">'+fecha+'</td>'+
          '<td style="padding:10px 14px;text-align:center;"><span style="font-size:11px;font-weight:700;color:'+sc+';background:'+sc+'20;border-radius:6px;padding:3px 10px;white-space:nowrap;">'+sl+'</span></td>'+
          '<td style="padding:10px 14px;text-align:center;"><div style="display:flex;gap:6px;justify-content:center;">'+
            (w.status!=='approved'?'<button onclick="wspApprove('+w.id+')" style="padding:5px 12px;border-radius:7px;border:1px solid #25d366;background:rgba(37,211,102,.08);color:#16a34a;font-size:11px;font-weight:700;cursor:pointer;white-space:nowrap;"><i class="bi bi-check-circle-fill"></i> Aprobar</button>':'')+
            (w.status!=='rejected'?'<button onclick="wspReject('+w.id+')" style="padding:5px 12px;border-radius:7px;border:1px solid #f59e0b;background:rgba(245,158,11,.08);color:#b45309;font-size:11px;font-weight:700;cursor:pointer;white-space:nowrap;"><i class="bi bi-x-circle"></i> Rechazar</button>':'')+
            '<button onclick="wspDelete('+w.id+')" style="padding:5px 10px;border-radius:7px;border:1px solid #fca5a5;background:rgba(239,68,68,.07);color:#dc2626;font-size:11px;font-weight:700;cursor:pointer;"><i class="bi bi-trash3"></i></button>'+
          '</div></td></tr>';
      }).join('')}</tbody>
    </table></div>`;
  } catch(e) {
    list.innerHTML = '<div style="color:#dc2626;font-size:13px;padding:20px;">Error: '+e.message+'</div>';
  }
}

async function wspApprove(id){
  const r = await fetch('/api/portal/whatsapp-requests/'+id, { method:'PUT', credentials:'include', headers:{'Content-Type':'application/json'}, body:JSON.stringify({status:'approved'}) });
  if(!(await r.json()).success) alert('Error al aprobar'); else loadWspRequests();
}
async function wspReject(id){
  const r = await fetch('/api/portal/whatsapp-requests/'+id, { method:'PUT', credentials:'include', headers:{'Content-Type':'application/json'}, body:JSON.stringify({status:'rejected'}) });
  if(!(await r.json()).success) alert('Error al rechazar'); else loadWspRequests();
}
async function wspDelete(id){
  if(!confirm('¿Eliminar esta solicitud?')) return;
  await fetch('/api/portal/whatsapp-requests/'+id, { method:'DELETE', credentials:'include' });
  loadWspRequests();
}

