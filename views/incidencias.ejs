<!DOCTYPE html>
<html lang="es">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title><%= title %> - Equipment Management</title>
    <link href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.1/font/bootstrap-icons.css" rel="stylesheet">
    <link href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.0.0/css/all.min.css" rel="stylesheet">
    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.2/dist/css/bootstrap.min.css" rel="stylesheet">
    <link rel="stylesheet" href="../css/style.css">
    <script src="https://cdn.jsdelivr.net/npm/chart.js@4.4.0/dist/chart.umd.min.js"></script>
    <style>
:root,[data-theme="light"]{
    --bg-main:#f5f7fa;--bg-card:#ffffff;--bg-header:#fafbfc;--border-soft:#e2e8f0;--border-row:#f1f5f9;
    --text-main:#1e293b;--text-muted:#64748b;--primary:#3b82f6;--success:#10b981;--warning:#f59e0b;
    --info:#06b6d4;--danger:#ef4444;--purple:#8b5cf6;--jira-blue:#0052cc;--jira-hover:#003d99;
    --hover-row:#f8fafc;--input-bg:#ffffff;--pill-bg:#ffffff;--upload-bg:transparent;
    --step2-bg:#f0fdf4;--step2-border:#bbf7d0;--step2-color:#065f46;
    --queue-unassigned-bg:#fff7ed;--queue-unassigned-border:#fed7aa;
    --queue-assigned-bg:#eff6ff;--queue-assigned-border:#bfdbfe;
    --ac-bg:#ffffff;--ac-hover:#f0f7ff;--ac-border:#f1f5f9;
    --no-access-bg:#fff7ed;--no-access-border:#fed7aa;--no-access-color:#92400e;
}
[data-theme="dark"]{
    --bg-main:#0f172a;--bg-card:#1e293b;--bg-header:#162032;--border-soft:#2d3f55;--border-row:#2d3f55;
    --text-main:#e2e8f0;--text-muted:#94a3b8;--primary:#60a5fa;--success:#34d399;--warning:#fbbf24;
    --info:#22d3ee;--danger:#f87171;--purple:#a78bfa;--jira-blue:#3b7dd8;--jira-hover:#2563b0;
    --hover-row:#243348;--input-bg:#162032;--pill-bg:#1e293b;--upload-bg:#162032;
    --step2-bg:#0a2a1a;--step2-border:#166534;--step2-color:#34d399;
    --queue-unassigned-bg:#2a1a00;--queue-unassigned-border:#78350f;
    --queue-assigned-bg:#1e3a5f;--queue-assigned-border:#2d5a9e;
    --ac-bg:#1e293b;--ac-hover:#243348;--ac-border:#2d3f55;
    --no-access-bg:#2a1a00;--no-access-border:#78350f;--no-access-color:#fbbf24;
}
body{margin:0;background:var(--bg-main);font-family:-apple-system,BlinkMacSystemFont,"Segoe UI",Roboto,sans-serif;color:var(--text-main);overflow-x:hidden;transition:background .3s,color .3s;}
.dashboard-wrapper{width:100%;padding:16px;margin-top:60px;}
.dashboard-content{width:100%;max-width:1680px;margin:0 auto;}
.cards-6{display:grid;grid-template-columns:repeat(6,1fr);gap:12px;margin-bottom:20px;}
@media(max-width:1400px){.cards-6{grid-template-columns:repeat(3,1fr);}}
@media(max-width:992px){.cards-6{grid-template-columns:repeat(2,1fr);}}
@media(max-width:576px){.cards-6{grid-template-columns:1fr;}}
.kpi-card{background:var(--bg-card);border-radius:12px;height:100px;padding:16px;display:flex;justify-content:space-between;align-items:center;border:1px solid var(--border-soft);box-shadow:0 1px 3px rgba(0,0,0,.05);transition:all .2s;cursor:pointer;}
.kpi-card:hover{transform:translateY(-2px);box-shadow:0 4px 12px rgba(0,0,0,.08);}
.kpi-title{font-size:10px;letter-spacing:.5px;text-transform:uppercase;color:var(--text-muted);font-weight:600;margin-bottom:6px;}
.kpi-value{font-size:28px;font-weight:700;line-height:1;}
.kpi-icon{font-size:32px;opacity:.25;}
.primary{color:var(--primary);}.success{color:var(--success);}.warning{color:var(--warning);}.info{color:var(--info);}.danger{color:var(--danger);}.purple{color:var(--purple);}
.page-header{display:flex;align-items:center;justify-content:space-between;margin-bottom:20px;flex-wrap:wrap;gap:12px;}
.page-title{font-size:22px;font-weight:700;color:var(--text-main);display:flex;align-items:center;gap:10px;}
.page-title .jira-badge{background:var(--jira-blue);color:white;font-size:10px;font-weight:700;padding:2px 8px;border-radius:20px;letter-spacing:.5px;}
.card-panel{background:var(--bg-card);border-radius:12px;border:1px solid var(--border-soft);box-shadow:0 1px 3px rgba(0,0,0,.05);padding:20px;margin-bottom:20px;transition:background .3s,border-color .3s;}
.card-panel-title{font-size:13px;font-weight:700;text-transform:uppercase;letter-spacing:.5px;color:var(--text-muted);margin-bottom:16px;display:flex;align-items:center;gap:8px;}
.badge-status{font-size:11px;font-weight:600;padding:3px 10px;border-radius:20px;display:inline-flex;align-items:center;gap:4px;}
.badge-open{background:#dbeafe;color:#1d4ed8;}.badge-progress{background:#fef3c7;color:#d97706;}.badge-closed{background:#d1fae5;color:#065f46;}
[data-theme="dark"] .badge-open{background:#1e3a5f;color:#93c5fd;}[data-theme="dark"] .badge-progress{background:#422006;color:#fde68a;}[data-theme="dark"] .badge-closed{background:#064e3b;color:#6ee7b7;}
.prio-dot{width:8px;height:8px;border-radius:50%;display:inline-block;margin-right:4px;}
.prio-low{background:#10b981;}.prio-medium{background:#f59e0b;}.prio-high{background:#ef4444;}
/* Prioridad badges */
.prio-badge{display:inline-flex;align-items:center;font-size:10px;font-weight:700;padding:2px 7px;border-radius:4px;letter-spacing:.3px;}
.prio-P1{background:#fee2e2;color:#dc2626;}.prio-P2{background:#fef3c7;color:#d97706;}
.prio-P3{background:#dbeafe;color:#1d4ed8;}.prio-P4{background:#f1f5f9;color:#64748b;}
[data-theme="dark"] .prio-P1{background:#450a0a;color:#f87171;}[data-theme="dark"] .prio-P2{background:#451a03;color:#fbbf24;}
[data-theme="dark"] .prio-P3{background:#1e3a5f;color:#93c5fd;}[data-theme="dark"] .prio-P4{background:#1e293b;color:#94a3b8;}
/* Estado interno badges */
.ist-badge{display:inline-flex;align-items:center;gap:4px;font-size:10px;font-weight:600;padding:3px 8px;border-radius:20px;}
.ist-abierto{background:#dbeafe;color:#1d4ed8;}.ist-asignado{background:#ede9fe;color:#7c3aed;}
.ist-en_progreso{background:#fef3c7;color:#d97706;}.ist-pendiente_usuario{background:#fee2e2;color:#dc2626;}
.ist-resuelto{background:#d1fae5;color:#065f46;}.ist-cerrado{background:#f1f5f9;color:#64748b;}
/* SLA semáforo */
.sla-ok{color:#10b981;font-weight:600;}.sla-warn{color:#f59e0b;font-weight:600;}.sla-danger{color:#ef4444;font-weight:600;}
/* Btn acción pequeño */
.btn-take{background:#0052CC;color:#fff;border:none;border-radius:6px;padding:4px 10px;font-size:11px;font-weight:600;cursor:pointer;transition:background .15s;}
.btn-take:hover{background:#003d99;}
.btn-manage{background:transparent;color:var(--jira-blue);border:1.5px solid var(--jira-blue);border-radius:6px;padding:4px 10px;font-size:11px;font-weight:600;cursor:pointer;transition:all .15s;}
.btn-manage:hover{background:var(--jira-blue);color:#fff;}
.table-tickets thead th{font-size:11px;text-transform:uppercase;letter-spacing:.4px;color:var(--text-muted);font-weight:600;border-bottom:2px solid var(--border-soft);padding:10px 12px;white-space:nowrap;background:var(--bg-header);}
.table-tickets td{padding:10px 12px;vertical-align:middle;font-size:13px;border-bottom:1px solid var(--border-row);color:var(--text-main);}
.table-tickets tbody tr:hover{background:var(--hover-row);}
[data-theme="dark"] .table-tickets{--bs-table-bg:transparent;}
[data-theme="dark"] .table-tickets tbody tr:hover td{background:var(--hover-row)!important;}
.ticket-key{font-family:monospace;font-weight:700;color:var(--jira-blue);font-size:12px;}
.ticket-key a{color:inherit;text-decoration:none;}
.ticket-key a:hover{text-decoration:underline;}
.quick-form{display:grid;grid-template-columns:1fr 1fr;gap:16px;}
@media(max-width:768px){.quick-form{grid-template-columns:1fr;}}
/* Toggle switch automatizaciones */
.auto-toggle-wrap{position:relative;display:inline-block;width:44px;height:24px;flex-shrink:0;}
.auto-toggle-wrap input{opacity:0;width:0;height:0;}
.auto-toggle{position:absolute;inset:0;background:var(--border-soft);border-radius:24px;cursor:pointer;transition:background .2s;}
.auto-toggle::before{content:'';position:absolute;width:18px;height:18px;left:3px;top:3px;background:#fff;border-radius:50%;transition:transform .2s;box-shadow:0 1px 3px rgba(0,0,0,.2);}
.auto-toggle-wrap input:checked + .auto-toggle{background:#0052CC;}
.auto-toggle-wrap input:checked + .auto-toggle::before{transform:translateX(20px);}
.form-label-custom{font-size:11px;font-weight:600;text-transform:uppercase;letter-spacing:.4px;color:var(--text-muted);margin-bottom:6px;}
.form-control-custom,.form-select-custom{border:1.5px solid var(--border-soft);border-radius:8px;padding:9px 12px;font-size:13px;transition:border-color .2s,background .3s,color .3s;width:100%;background:var(--input-bg);color:var(--text-main);}
.form-control-custom:focus,.form-select-custom:focus{outline:none;border-color:var(--primary);box-shadow:0 0 0 3px rgba(59,130,246,.1);}
.form-control-custom::placeholder{color:var(--text-muted);}
textarea.form-control-custom{resize:vertical;}
.btn-create{background:var(--jira-blue);color:white;border:none;border-radius:8px;padding:10px 24px;font-size:13px;font-weight:600;cursor:pointer;display:flex;align-items:center;gap:8px;transition:all .2s;}
.btn-create:hover{background:var(--jira-hover);transform:translateY(-1px);}
.btn-create:disabled{opacity:.6;cursor:not-allowed;transform:none;}
.btn-outline-sm{border:1.5px solid var(--border-soft);background:transparent;border-radius:6px;padding:4px 10px;font-size:11px;font-weight:600;cursor:pointer;transition:all .15s;color:var(--text-muted);display:inline-flex;align-items:center;gap:4px;}
.btn-outline-sm:hover{border-color:var(--primary);color:var(--primary);background:var(--hover-row);}
.btn-close-ticket{border-color:#fca5a5;color:#dc2626;}
.btn-close-ticket:hover{background:#fee2e2;border-color:#dc2626;color:#dc2626;}
[data-theme="dark"] .btn-close-ticket{border-color:#7f1d1d;color:#f87171;}
[data-theme="dark"] .btn-close-ticket:hover{background:#450a0a;border-color:#f87171;color:#f87171;}
.search-bar{display:flex;gap:10px;align-items:center;margin-bottom:16px;flex-wrap:wrap;}
.search-input-wrap{position:relative;flex:1;min-width:200px;}
.search-input-wrap i{position:absolute;left:11px;top:50%;transform:translateY(-50%);color:var(--text-muted);font-size:14px;}
.search-input-wrap input{padding-left:34px;border:1.5px solid var(--border-soft);border-radius:8px;padding-top:8px;padding-bottom:8px;font-size:13px;width:100%;background:var(--input-bg);color:var(--text-main);}
.search-input-wrap input::placeholder{color:var(--text-muted);}
.search-input-wrap input:focus{outline:none;border-color:var(--primary);box-shadow:0 0 0 3px rgba(59,130,246,.1);}
.filter-pills{display:flex;gap:6px;flex-wrap:wrap;}
.pill{border:1.5px solid var(--border-soft);background:var(--pill-bg);border-radius:20px;padding:4px 14px;font-size:12px;font-weight:600;cursor:pointer;transition:all .15s;color:var(--text-muted);}
.pill.active{background:var(--jira-blue);border-color:var(--jira-blue);color:white;}
.pill:hover:not(.active){border-color:var(--jira-blue);color:var(--jira-blue);}
.spinner-wrap{display:flex;align-items:center;justify-content:center;padding:40px;color:var(--text-muted);gap:10px;font-size:13px;}
.toast-container-custom{position:fixed;bottom:24px;right:24px;z-index:9999;display:flex;flex-direction:column;gap:8px;}
.toast-msg{background:var(--text-main);color:white;padding:12px 18px;border-radius:10px;font-size:13px;font-weight:500;display:flex;align-items:center;gap:10px;box-shadow:0 4px 20px rgba(0,0,0,.2);animation:slideUp .3s ease;min-width:280px;}
.toast-msg.success{background:#065f46;}.toast-msg.error{background:#991b1b;}
@keyframes slideUp{from{transform:translateY(20px);opacity:0;}to{transform:translateY(0);opacity:1;}}
.upload-zone{border:2px dashed var(--border-soft);border-radius:8px;padding:20px;text-align:center;cursor:pointer;transition:all .2s;color:var(--text-muted);font-size:13px;position:relative;background:var(--upload-bg);}
.upload-zone:hover,.upload-zone.dragover{border-color:var(--primary);color:var(--primary);background:var(--hover-row);}
.upload-zone input[type="file"]{position:absolute;inset:0;opacity:0;cursor:pointer;}
.upload-preview{display:flex;align-items:center;gap:8px;margin-top:8px;font-size:12px;color:var(--success);}
.modal-header-custom{background:linear-gradient(135deg,var(--jira-blue),#0065ff);color:white;border-radius:12px 12px 0 0;padding:16px 20px;}
.modal-content{border-radius:12px;border:none;box-shadow:0 20px 60px rgba(0,0,0,.15);}
[data-theme="dark"] .modal-content{background:var(--bg-card)!important;color:var(--text-main)!important;}
[data-theme="dark"] .modal-body{background:var(--bg-card)!important;}
[data-theme="dark"] .modal-footer{background:var(--bg-header)!important;border-color:var(--border-soft)!important;}
[data-theme="dark"] .btn-close{filter:invert(1);}
.empty-state{text-align:center;padding:48px 20px;color:var(--text-muted);}
.empty-state i{font-size:48px;opacity:.3;margin-bottom:12px;display:block;}
.empty-state p{font-size:14px;margin:0;}
@keyframes flashPulse{0%{box-shadow:0 0 0 0 rgba(0,82,204,.4);}70%{box-shadow:0 0 0 10px rgba(0,82,204,0);}100%{box-shadow:0 0 0 0 rgba(0,82,204,0);}}
.flash-new{animation:flashPulse 1s ease 3;}
/* Autocomplete */
.autocomplete-wrap{position:relative;}
.ac-dropdown{position:absolute;top:calc(100% + 4px);left:0;right:0;background:var(--ac-bg);border:1.5px solid var(--border-soft);border-radius:10px;box-shadow:0 10px 36px rgba(0,0,0,.12);max-height:280px;overflow-y:auto;z-index:1060;display:none;}
.ac-dropdown.show{display:block;animation:dropIn .15s ease;}
@keyframes dropIn{from{opacity:0;transform:translateY(-5px);}to{opacity:1;transform:translateY(0);}}
.ac-item{padding:10px 14px;cursor:pointer;border-bottom:1px solid var(--ac-border);transition:background .12s;}
.ac-item:last-child{border-bottom:none;}
.ac-item:hover,.ac-item.active-ac{background:var(--ac-hover);}
.ac-email{font-weight:600;font-size:13px;color:var(--text-main);display:block;margin-bottom:2px;}
.ac-details{font-size:11px;color:var(--text-muted);}
.ac-empty{padding:14px;text-align:center;color:var(--text-muted);font-size:13px;}
/* Modal tabs */
.search-modal-tabs{display:flex;border-bottom:2px solid var(--border-soft);margin-bottom:20px;}
.search-tab-btn{flex:1;background:none;border:none;border-bottom:3px solid transparent;padding:10px 12px;font-size:12px;font-weight:600;color:var(--text-muted);cursor:pointer;transition:all .2s;display:flex;align-items:center;justify-content:center;gap:6px;margin-bottom:-2px;white-space:nowrap;}
.search-tab-btn:hover{color:var(--jira-blue);}
.search-tab-btn.active{color:var(--jira-blue);border-bottom-color:var(--jira-blue);}
.tab-badge{background:var(--jira-blue);color:white;font-size:10px;font-weight:700;padding:1px 6px;border-radius:10px;min-width:18px;text-align:center;}
.tab-badge.orange{background:#f59e0b;}
.tab-panel{display:none;}.tab-panel.active{display:block;}
/* No access banner */
.no-access-banner{background:var(--no-access-bg);border:1.5px solid var(--no-access-border);border-radius:10px;padding:20px 24px;text-align:center;}
.no-access-banner i{font-size:32px;color:var(--no-access-color);display:block;margin-bottom:10px;opacity:.8;}
.no-access-banner h6{font-size:14px;font-weight:700;color:var(--no-access-color);margin-bottom:6px;}
.no-access-banner p{font-size:12px;color:var(--text-muted);margin:0;line-height:1.6;}
/* Queue rows */
.queue-ticket-row{display:flex;align-items:center;gap:10px;padding:10px 12px;border-radius:8px;border:1px solid var(--border-soft);background:var(--bg-card);margin-bottom:6px;transition:all .15s;flex-wrap:wrap;}
.queue-ticket-row:hover{border-color:var(--jira-blue);background:var(--hover-row);}
.queue-ticket-key{font-family:monospace;font-weight:700;color:var(--jira-blue);font-size:12px;min-width:80px;flex-shrink:0;}
.queue-ticket-key a{color:inherit;text-decoration:none;}
.queue-ticket-summary{flex:1;font-size:13px;color:var(--text-main);min-width:0;white-space:nowrap;overflow:hidden;text-overflow:ellipsis;}
.queue-ticket-meta{font-size:11px;color:var(--text-muted);flex-shrink:0;}
.queue-ticket-actions{display:flex;gap:6px;flex-shrink:0;}
.queue-empty{text-align:center;padding:32px 20px;color:var(--text-muted);}
.queue-empty i{font-size:36px;opacity:.3;display:block;margin-bottom:8px;}
.queue-empty p{font-size:13px;margin:0;}
.queue-list-scroll{max-height:400px;overflow-y:auto;padding-right:2px;}
/* Corporate Tab Nav */
.corp-tabnav{display:flex;gap:0;border-bottom:2px solid var(--border-soft);margin-bottom:24px;background:var(--bg-card);border-radius:12px 12px 0 0;padding:0 8px;box-shadow:0 1px 3px rgba(0,0,0,.04);}
.corp-tab{background:none;border:none;border-bottom:3px solid transparent;padding:14px 20px;font-size:13px;font-weight:600;color:var(--text-muted);cursor:pointer;display:inline-flex;align-items:center;gap:8px;transition:all .2s;margin-bottom:-2px;white-space:nowrap;}
.corp-tab:hover{color:var(--jira-blue);}
.corp-tab.active{color:var(--jira-blue);border-bottom-color:var(--jira-blue);}
.corp-tab i{font-size:14px;}
.corp-tabpanel{animation:fadeIn .2s ease;}
@keyframes fadeIn{from{opacity:0;transform:translateY(4px);}to{opacity:1;transform:translateY(0);}}
/* Category tiles */
.cat-tile{padding:8px 14px;border:1.5px solid var(--border-soft);border-radius:8px;background:var(--bg-card);cursor:pointer;display:inline-flex;align-items:center;gap:6px;font-size:12px;font-weight:600;transition:all .15s;color:var(--text-muted);white-space:nowrap;}
.cat-tile:hover{border-color:var(--jira-blue);color:var(--jira-blue);background:var(--hover-row);}
.cat-tile.active{border-color:var(--jira-blue);background:rgba(0,82,204,.1);color:var(--jira-blue);}
[data-theme="dark"] .cat-tile.active{background:rgba(59,125,216,.15);}
    </style>
</head>
<body>

<div class="sidebar-overlay" id="sidebarOverlay"></div>
<div class="sidebar" id="sidebar">
    <div class="sidebar-header"><button class="close-sidebar" id="closeSidebar"><i class="fas fa-times"></i></button></div>
    <div class="menu-item"><a href="<%= APP_URL %>/home" class="menu-header"><div class="menu-title"><i class="fas fa-home"></i><span>Home</span></div></a></div>
    <div class="menu-item"><a href="<%= APP_URL %>/warranty" class="menu-header"><div class="menu-title"><i class="fas fa-shield-alt"></i><span>Garantías</span></div></a></div>
    <div class="menu-item"><a href="<%= APP_URL %>/tickets" class="menu-header"><div class="menu-title"><i class="fas fa-ticket-alt"></i><span>Tickets</span></div></a></div>
    <div class="menu-item"><a href="<%= APP_URL %>/sccm" class="menu-header"><div class="menu-title"><i class="fas fa-shield-alt"></i><span>Panda</span></div></a></div>
    <div class="menu-item"><a href="#" class="menu-header"><div class="menu-title"><i class="fas fa-cog"></i><span>Administración</span></div></a></div>
    <div class="menu-item"><a href="<%= APP_URL %>/logout" class="menu-header"><div class="menu-title"><i class="fas fa-sign-out-alt"></i><span>Cerrar Sesión</span></div></a></div>
</div>

<nav class="navbar navbar-expand-lg fixed-top" id="navbar">
    <div class="container-fluid">
        <button class="toggler-btn" id="mainToggleSidebar"><i class="fas fa-bars"></i></button>
        <div class="theme-toggle-wrap ms-auto" onclick="toggleTheme()" role="button">
            <i class="theme-toggle-icon" id="toggleIcon">🌙</i>
            <div class="theme-switch"><div class="theme-switch-knob" id="switchKnob"></div></div>
            <span class="theme-toggle-label" id="toggleLabel">Oscuro</span>
        </div>
    </div>
</nav>

<style>
.theme-toggle-wrap{display:flex;align-items:center;gap:7px;cursor:pointer;user-select:none;padding:4px 10px 4px 8px;border-radius:20px;transition:background .2s;}
.theme-toggle-wrap:hover{background:rgba(0,0,0,0.06);}
[data-theme="dark"] .theme-toggle-wrap:hover{background:rgba(255,255,255,0.08);}
.theme-toggle-icon{font-size:14px;line-height:1;transition:transform .4s cubic-bezier(.4,0,.2,1);display:flex;align-items:center;}
.theme-toggle-wrap:hover .theme-toggle-icon{transform:rotate(20deg);}
.theme-switch{width:34px;height:18px;background:#cbd5e1;border-radius:9px;position:relative;transition:background .3s;flex-shrink:0;}
[data-theme="dark"] .theme-switch{background:#3b82f6;}
.theme-switch-knob{width:13px;height:13px;background:#fff;border-radius:50%;position:absolute;top:2.5px;left:3px;box-shadow:0 1px 3px rgba(0,0,0,.25);transition:transform .3s cubic-bezier(.4,0,.2,1);}
[data-theme="dark"] .theme-switch-knob{transform:translateX(16px);}
.theme-toggle-label{font-size:12px;font-weight:600;color:#64748b;transition:color .3s;white-space:nowrap;}
[data-theme="dark"] .theme-toggle-label{color:#94a3b8;}
</style>

<script>
(function(){document.documentElement.setAttribute('data-theme',localStorage.getItem('dashboardTheme')||'light');})();
function toggleTheme(){const h=document.documentElement,c=h.getAttribute('data-theme'),n=c==='dark'?'light':'dark';h.setAttribute('data-theme',n);localStorage.setItem('dashboardTheme',n);_syncUI(n);}
function _syncUI(t){const i=document.getElementById('toggleIcon'),l=document.getElementById('toggleLabel');if(!i||!l)return;i.textContent=t==='dark'?'☀️':'🌙';l.textContent=t==='dark'?'Claro':'Oscuro';}
document.addEventListener('DOMContentLoaded',()=>_syncUI(localStorage.getItem('dashboardTheme')||'light'));
</script>

<div class="dashboard-wrapper">
<div class="dashboard-content">

  <!-- ── Tab Nav corporativo ── -->
  <%
    const _role = user?.role || 'usuario';
    // Perfiles de acceso
    // administrador : todo
    // especialista  : Registrar, Gestión, Indicadores, Categorías
    // visor         : Registrar, Indicadores
    // usuario       : Registrar
    const _isAdmin       = _role === 'administrador';
    const _isEspecialista= ['especialista','agente','tecnico'].includes(_role);
    const _isVisor       = _role === 'visor';
    // alias para JS client-side
  %>
  <nav class="corp-tabnav" role="tablist">
    <button class="corp-tab active" id="tabBtnCreate"       onclick="doTab('create',this)"><i class="bi bi-pencil-square"></i> Registrar</button>
    <% if (_isAdmin || _isEspecialista) { %>
    <button class="corp-tab"        id="tabBtnGestion"      onclick="doTab('gestion',this)"><i class="bi bi-ticket-detailed"></i> Gestión</button>
    <% } %>
    <% if (_isAdmin || _isEspecialista || _isVisor) { %>
    <button class="corp-tab"        id="tabBtnKpis"         onclick="doTab('kpis',this)"><i class="bi bi-bar-chart-line"></i> Indicadores</button>
    <% } %>
    <% if (_isAdmin || _isEspecialista) { %>
    <button class="corp-tab"        id="tabBtnCategorias"   onclick="doTab('categorias',this)"><i class="bi bi-tags"></i> Categorías</button>
    <% } %>
    <% if (_isAdmin) { %>
    <button class="corp-tab"        id="tabBtnEspecialistas"onclick="doTab('especialistas',this)"><i class="bi bi-people"></i> Especialistas</button>
    <button class="corp-tab"        id="tabBtnAutomaciones" onclick="doTab('automaciones',this)"><i class="bi bi-gear-wide-connected"></i> Automatizaciones</button>
    <button class="corp-tab"        id="tabBtnAdmin"        onclick="doTab('admin',this)"><i class="bi bi-shield-lock"></i> Administración</button>
    <% } %>
    <% if (_isAdmin || _isEspecialista) { %>
    <button class="corp-tab"        id="tabBtnPortal"       onclick="doTab('portal',this);loadPortalMetrics()"><i class="bi bi-people-fill"></i> Portal</button>
    <button class="corp-tab"        id="tabBtnPreguntas"    onclick="doTab('preguntas',this);loadUserQuestions()"><i class="bi bi-chat-dots-fill"></i> Preguntas</button>
    <button class="corp-tab"        id="tabBtnEncuesta"     onclick="doTab('encuesta',this);loadSurveyGeneralResults()"><i class="bi bi-star-half"></i> Encuesta</button>
    <button class="corp-tab"        id="tabBtnWhatsapp"     onclick="doTab('whatsapp',this);loadWspRequests()"><i class="bi bi-whatsapp"></i> WhatsApp Bot</button>
    <button class="corp-tab"        id="tabBtnKbReqs"       onclick="doTab('kbreqs',this);loadKbRequests()"><i class="bi bi-book"></i> Solicitudes KB <span id="kbReqBadge" style="display:none;background:#ef4444;color:#fff;border-radius:10px;padding:1px 7px;font-size:10px;margin-left:3px;"></span></button>
    <% } %>
    <%# Resumen de accesos por perfil:
        administrador : Registrar · Gestión · Indicadores · Categorías · Especialistas · Automatizaciones · Admin
        especialista  : Registrar · Gestión · Indicadores · Categorías
        visor         : Registrar · Indicadores
        usuario       : Registrar
    %>
  </nav>
  <script>
  var _tabLoaded = {};
  function doTab(name, btn) {
      var panels = {create:'tabCreate', gestion:'tabGestion', categorias:'tabCategorias', kpis:'tabKpis', especialistas:'tabEspecialistas', automaciones:'tabAutomaciones', admin:'tabAdmin', portal:'tabPortal', preguntas:'tabPreguntas', encuesta:'tabEncuesta', whatsapp:'tabWhatsapp', kbreqs:'tabKbReqs'};
      Object.values(panels).forEach(function(id){ var el=document.getElementById(id); if(el) el.style.display='none'; });
      document.querySelectorAll('.corp-tab').forEach(function(b){ b.classList.remove('active'); });
      var target = document.getElementById(panels[name]);
      if (target) target.style.display = 'block';
      if (btn) btn.classList.add('active');
      if (!_tabLoaded[name]) {
          _tabLoaded[name] = true;
          setTimeout(function(){
              if (name==='gestion'       && typeof loadTickets        ==='function') loadTickets();
              if (name==='categorias'    && typeof loadCatListInline   ==='function') loadCatListInline();
              if (name==='kpis'          && typeof loadStats           ==='function') loadStats();
              if (name==='especialistas' && typeof loadSpecialists     ==='function') loadSpecialists();
              if (name==='automaciones'  && typeof loadAutomations     ==='function') loadAutomations();
              if (name==='admin'         && typeof loadAdminUsers      ==='function') loadAdminUsers();
              if (name==='portal') { if(typeof loadPortalMetrics==='function') loadPortalMetrics(); if(typeof pmqLoadList==='function') pmqLoadList(); }
              if (name==='preguntas' && typeof loadUserQuestions==='function') { loadUserQuestions(); loadAdminContribs(); loadWspRequests(); }
          }, 0);
      }
  }
  </script>

  <!-- ══ TAB 1: Registrar Incidencia (vista usuario) ══ -->
  <div id="tabCreate" class="corp-tabpanel">
    <div style="max-width:660px;margin:0 auto;">
      <div class="card-panel">
        <div style="text-align:center;margin-bottom:24px;padding-bottom:20px;border-bottom:1px solid var(--border-soft);">
          <div style="width:60px;height:60px;display:flex;align-items:center;justify-content:center;margin:0 auto 12px;">
              <img src="https://w7.pngwing.com/pngs/346/124/png-transparent-movistar-colombia-claro-internet-movistar-logo-internet-mobile-phones-thumbnail.png"
                   alt="Movistar" style="width:56px;height:56px;object-fit:contain;">
          </div>
          <div style="font-size:18px;font-weight:700;color:var(--text-main);">Registrar Incidencia</div>
          <div style="font-size:12px;color:var(--text-muted);margin-top:4px;">Service Desk · Portal IT</div>
        </div>
        <div style="display:flex;flex-direction:column;gap:18px;">
          <!-- Reporter -->
          <div>
            <div class="form-label-custom">Tu correo corporativo *</div>
            <div class="autocomplete-wrap">
                <input type="email" id="cf_reporter" class="form-control-custom"
                       placeholder="usuario@empresa.com" autocomplete="off"
                       oninput="acCfReporter(this.value)" onkeydown="acKeydown(event,'acCfReporterDrop')"
                       onblur="loadEmployeeInfo(this.value.trim())">
                <div id="acCfReporterDrop" class="ac-dropdown"></div>
            </div>
          </div>
          <!-- Info equipo (se llena al elegir reporter) -->
          <div id="cfEmployeeInfo" style="display:none;background:var(--step2-bg);border:1.5px solid var(--step2-border);border-radius:10px;padding:14px 16px;">
            <div style="font-size:11px;font-weight:700;text-transform:uppercase;letter-spacing:.5px;color:var(--step2-color);margin-bottom:10px;display:flex;align-items:center;gap:6px;"><i class="bi bi-pc-display-horizontal"></i> Información del equipo asociado</div>
            <div style="display:grid;grid-template-columns:1fr 1fr;gap:8px 16px;">
              <div>
                <div style="font-size:10px;font-weight:600;color:var(--text-muted);text-transform:uppercase;letter-spacing:.4px;margin-bottom:2px;">Equipo / Tag</div>
                <div id="cfEqEquipo" style="font-size:13px;font-weight:600;color:var(--text-main);">—</div>
              </div>
              <div>
                <div style="font-size:10px;font-weight:600;color:var(--text-muted);text-transform:uppercase;letter-spacing:.4px;margin-bottom:2px;">Modelo</div>
                <div id="cfEqModelo" style="font-size:13px;font-weight:600;color:var(--text-main);">—</div>
              </div>
              <div>
                <div style="font-size:10px;font-weight:600;color:var(--text-muted);text-transform:uppercase;letter-spacing:.4px;margin-bottom:2px;">Departamento</div>
                <div id="cfEqDepartamento" style="font-size:13px;font-weight:600;color:var(--text-main);">—</div>
              </div>
              <div>
                <div style="font-size:10px;font-weight:600;color:var(--text-muted);text-transform:uppercase;letter-spacing:.4px;margin-bottom:2px;">Ubicación</div>
                <div id="cfEqUbicacion" style="font-size:13px;font-weight:600;color:var(--text-main);">—</div>
              </div>
            </div>
          </div>
          <!-- Categoría / Problema -->
          <div>
            <div class="form-label-custom">¿Cuál es tu problema? *</div>
            <div class="autocomplete-wrap">
                <input type="text" id="cf_summary" class="form-control-custom"
                       placeholder="Escribe para buscar el tipo de problema..." autocomplete="off"
                       oninput="acCategory(this.value);triggerKbSuggest(this.value)" onkeydown="acKeydown(event,'acCategoryDrop')">
                <div id="acCategoryDrop" class="ac-dropdown"></div>
            </div>
            <div id="catSelectedBadge" style="display:none;margin-top:8px;align-items:center;gap:8px;">
                <span id="catBadgeText" style="background:rgba(0,82,204,.1);border:1px solid rgba(0,82,204,.3);color:var(--jira-blue);padding:5px 14px;border-radius:20px;font-size:12px;font-weight:600;display:inline-flex;align-items:center;gap:6px;"></span>
                <button onclick="clearCatSelection()" style="background:none;border:none;cursor:pointer;color:var(--text-muted);font-size:11px;padding:4px 8px;border-radius:6px;border:1px solid var(--border-soft);">✕ cambiar</button>
            </div>
          </div>
          <!-- Description -->
          <div>
            <div class="form-label-custom">Descripción del problema <span style="font-weight:400;color:var(--text-muted);font-size:10px;">(auto-generada, editable)</span></div>
            <textarea id="cf_description" class="form-control-custom" rows="3"
                      placeholder="Se completará al seleccionar el tipo de problema..."></textarea>
          </div>
          <!-- KB Sugerida -->
          <div id="kbSuggestWrap" style="display:none;">
            <div style="display:flex;align-items:center;gap:8px;margin-bottom:8px;">
              <i class="bi bi-lightbulb-fill" style="color:#f59e0b;"></i>
              <span style="font-size:12px;font-weight:700;color:var(--text-main);">Artículos relacionados — ¿ya revisaste la Base de Conocimiento?</span>
            </div>
            <div id="kbSuggestList" style="display:flex;flex-direction:column;gap:6px;"></div>
          </div>
          <!-- Phone -->
          <div>
            <div class="form-label-custom">Teléfono de contacto</div>
            <input type="text" id="cf_phone" class="form-control-custom" value="-" placeholder="-">
            <div style="font-size:11px;color:var(--text-muted);margin-top:3px;">Déjalo en "-" si no aplica</div>
          </div>
          <!-- Adjunto -->
          <div>
            <div class="form-label-custom">Adjunto de evidencia <span style="font-weight:400;color:var(--text-muted);font-size:10px;">(opcional)</span></div>
            <div class="upload-zone" id="cfUploadZone" style="padding:14px;">
                <input type="file" id="cf_attachment" accept="image/*,.pdf" onchange="cfHandleFile(this)">
                <i class="bi bi-cloud-upload" style="font-size:20px;display:block;margin-bottom:4px;"></i>
                Arrastra o haz clic para adjuntar evidencia
                <div style="font-size:11px;margin-top:2px;opacity:.7">PNG, JPG, PDF · máx 10MB</div>
            </div>
            <div id="cfUploadPreview" style="display:none;" class="upload-preview">
                <i class="bi bi-check-circle-fill"></i>
                <span id="cfUploadFileName"></span>
                <button type="button" onclick="cfClearFile()" style="background:none;border:none;cursor:pointer;color:#dc2626;font-size:12px;">✕</button>
            </div>
          </div>
          <!-- Hidden Jira fields -->
          <input type="hidden" id="cf_component">
          <input type="hidden" id="cf_app">
          <input type="hidden" id="cf_tipologia">
          <input type="hidden" id="cf_impact">
          <input type="hidden" id="cf_urgency">
          <!-- Result -->
          <div id="cfResult" style="display:none;padding:14px;border-radius:8px;background:#eff6ff;border:1.5px solid #bfdbfe;">
              <div style="font-size:12px;color:#1e40af;font-weight:600;margin-bottom:6px;">✅ Incidencia registrada exitosamente</div>
              <div style="display:flex;align-items:center;gap:10px;flex-wrap:wrap;">
                  <span class="ticket-key" id="cfCreatedKey" style="font-size:15px;"></span>
                  <a id="cfCreatedUrl" href="#" target="_blank" class="btn-outline-sm"><i class="bi bi-box-arrow-up-right"></i> Ver en Jira</a>
                  <button class="btn-outline-sm" onclick="resetCfForm()"><i class="bi bi-plus"></i> Nueva incidencia</button>
              </div>
          </div>
          <!-- Submit -->
          <button type="button" class="btn-create" id="cfBtnSubmit" onclick="submitTicketSimple()" style="width:100%;justify-content:center;padding:13px;font-size:14px;border-radius:10px;">
              <i class="bi bi-send-fill"></i> Registrar Incidencia
          </button>
        </div>
      </div>
    </div>
  </div>

  <!-- ══ TAB 2: Gestión de Tickets (técnico) ══ -->
  <div id="tabGestion" class="corp-tabpanel" style="display:none;">
    <div class="page-header" style="margin-top:4px;">
      <div class="page-title">
          <i class="bi bi-ticket-detailed-fill" style="color:var(--jira-blue)"></i>
          Gestión de Incidencias <span class="jira-badge">JIRA</span>
      </div>
      <div style="display:flex;gap:8px;align-items:center;flex-wrap:wrap;">
          <button class="btn-outline-sm" onclick="loadTickets()"><i class="bi bi-arrow-clockwise"></i> Actualizar</button>
          <button class="btn-outline-sm" id="btnSync" onclick="syncJira()" style="border-color:#7c6ff7;color:#7c6ff7;"><i class="bi bi-cloud-download"></i> Sincronizar Jira</button>
          <button class="btn-outline-sm" onclick="openSearchModal()" style="border-color:var(--jira-blue);color:var(--jira-blue);"><i class="bi bi-search"></i> Consultar / Cola</button>
      </div>
    </div>
    <div class="cards-6">
        <div class="kpi-card"><div><div class="kpi-title">Total</div><div class="kpi-value primary" id="kpiTotal">—</div></div><div class="kpi-icon"><i class="bi bi-ticket-detailed primary"></i></div></div>
        <div class="kpi-card"><div><div class="kpi-title">Abiertos</div><div class="kpi-value info" id="kpiOpen">—</div></div><div class="kpi-icon"><i class="bi bi-folder2-open info"></i></div></div>
        <div class="kpi-card"><div><div class="kpi-title">En Progreso</div><div class="kpi-value warning" id="kpiProgress">—</div></div><div class="kpi-icon"><i class="bi bi-gear-wide-connected warning"></i></div></div>
        <div class="kpi-card"><div><div class="kpi-title">Cerrados</div><div class="kpi-value success" id="kpiClosed">—</div></div><div class="kpi-icon"><i class="bi bi-check2-circle success"></i></div></div>
        <div class="kpi-card"><div><div class="kpi-title">Críticos</div><div class="kpi-value danger" id="kpiCritical">—</div></div><div class="kpi-icon"><i class="bi bi-exclamation-triangle danger"></i></div></div>
        <div class="kpi-card"><div><div class="kpi-title">Este Mes</div><div class="kpi-value purple" id="kpiMonth">—</div></div><div class="kpi-icon"><i class="bi bi-calendar3 purple"></i></div></div>
    </div>
    <div class="card-panel">
        <div class="card-panel-title"><i class="bi bi-list-ul" style="color:var(--jira-blue)"></i> Listado de Incidencias</div>
        <div class="search-bar">
            <div class="search-input-wrap">
                <i class="bi bi-search"></i>
