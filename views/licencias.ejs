    else html+=`<span class="bc-item" onclick="drillDir(1,'${escJs(_selDir)}')">${escape(_selDir)}</span>`;
  }
  if(level===2&&_selArea) html+=`<span class="bc-sep">›</span><span class="bc-item bc-current">${escape(_selArea)}</span>`;
  bc.innerHTML=html;
}

function escJs(s){return(s||'').replace(/\\/g,'\\\\').replace(/'/g,"\\'");}

