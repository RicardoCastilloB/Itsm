<!DOCTYPE html>
<html lang="es" data-theme="light">
<head>
<meta charset="UTF-8">
<link href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.1/font/bootstrap-icons.css" rel="stylesheet">
<style>
:root,[data-theme="light"]{
  --bg-main:#f0f4f9;--bg-card:#fff;--border-soft:#e2e8f0;
  --text-main:#1e293b;--text-muted:#64748b;
  --primary:#3b82f6;--success:#10b981;--warning:#f59e0b;--info:#06b6d4;
  --danger:#ef4444;--purple:#8b5cf6;--pink:#ec4899;
  --shadow-card:0 2px 8px rgba(0,0,0,.06);--shadow-hover:0 12px 32px rgba(59,130,246,.18);
  --toggle-bg:#e2e8f0;--toggle-knob:#fff;--toggle-icon:#64748b;
  --shine:rgba(255,255,255,.55);--grid-line:rgba(59,130,246,.07);
  --hero-text:#1e293b;--hero-sub:#64748b;--chip-bg:rgba(59,130,246,.08);--chip-color:#3b82f6;
  --tab-active:#fff;--tab-inactive:rgba(0,0,0,.04);--sidebar-bg:#fff;
}
[data-theme="dark"]{
  --bg-main:#0b1120;--bg-card:#131f35;--border-soft:#1e3050;
  --text-main:#e2e8f0;--text-muted:#94a3b8;
  --primary:#60a5fa;--success:#34d399;--warning:#fbbf24;--info:#22d3ee;
  --danger:#f87171;--purple:#a78bfa;--pink:#f472b6;
  --shadow-card:0 2px 12px rgba(0,0,0,.4);--shadow-hover:0 14px 40px rgba(96,165,250,.22);
  --toggle-bg:#3b82f6;--toggle-knob:#fff;--toggle-icon:#fff;
  --shine:rgba(255,255,255,.04);--grid-line:rgba(96,165,250,.06);
  --hero-text:#e2e8f0;--hero-sub:#94a3b8;--chip-bg:rgba(96,165,250,.12);--chip-color:#60a5fa;
  --tab-active:#131f35;--tab-inactive:rgba(255,255,255,.04);--sidebar-bg:#0f1929;
}
*,*::before,*::after{box-sizing:border-box;margin:0;padding:0;}
html,body{min-height:100%;font-family:'Segoe UI',system-ui,sans-serif;background:var(--bg-main);color:var(--text-main);overflow-x:hidden;transition:background .35s,color .35s;}
body::before{content:'';position:fixed;inset:0;background-image:linear-gradient(var(--grid-line) 1px,transparent 1px),linear-gradient(90deg,var(--grid-line) 1px,transparent 1px);background-size:48px 48px;pointer-events:none;z-index:0;}

.theme-toggle{position:fixed;top:14px;right:16px;z-index:9999;display:flex;align-items:center;gap:8px;background:var(--bg-card);border:1px solid var(--border-soft);border-radius:30px;padding:6px 14px 6px 10px;box-shadow:var(--shadow-card);cursor:pointer;user-select:none;transition:all .25s;}
.theme-toggle:hover{box-shadow:0 6px 20px rgba(0,0,0,.15);}
.toggle-track{width:40px;height:22px;background:var(--toggle-bg);border-radius:11px;position:relative;flex-shrink:0;}
.toggle-knob{width:16px;height:16px;background:var(--toggle-knob);border-radius:50%;position:absolute;top:3px;left:3px;transition:transform .3s cubic-bezier(.4,0,.2,1);box-shadow:0 1px 4px rgba(0,0,0,.3);}
[data-theme="dark"] .toggle-knob{transform:translateX(18px);}
.toggle-icon{font-size:14px;color:var(--toggle-icon);}
.toggle-label{font-size:12px;font-weight:600;color:var(--text-muted);white-space:nowrap;}

.home-wrapper{position:relative;z-index:1;min-height:100vh;display:flex;flex-direction:column;align-items:center;padding:40px 24px 80px;}

.hero{text-align:center;margin-bottom:28px;animation:fadeDown .7s ease both;}
.hero-logo{display:inline-flex;align-items:center;gap:12px;margin-bottom:12px;}
.hero-logo-icon{width:52px;height:52px;background:linear-gradient(135deg,var(--primary),var(--info));border-radius:14px;display:flex;align-items:center;justify-content:center;font-size:26px;color:#fff;box-shadow:0 6px 20px rgba(59,130,246,.35);}
.hero-logo-text{font-size:26px;font-weight:800;letter-spacing:-1px;color:var(--hero-text);}
.hero-logo-text span{color:var(--primary);}
.hero-title{font-size:13px;color:var(--hero-sub);font-family:monospace;letter-spacing:.5px;}
.hero-chip{display:inline-flex;align-items:center;gap:6px;background:var(--chip-bg);color:var(--chip-color);border:1px solid color-mix(in srgb,var(--primary) 25%,transparent);border-radius:20px;padding:4px 14px;font-size:11px;font-weight:600;letter-spacing:.8px;text-transform:uppercase;margin-top:10px;}

.tabs-wrapper{width:100%;max-width:1040px;margin-bottom:22px;}
.tabs-nav{display:flex;background:var(--tab-inactive);border:1px solid var(--border-soft);border-radius:14px;padding:5px;gap:4px;}
.tab-btn{flex:1;padding:10px 20px;border:none;border-radius:10px;font-size:13.5px;font-weight:600;cursor:pointer;background:transparent;color:var(--text-muted);display:flex;align-items:center;justify-content:center;gap:8px;transition:all .25s;}
.tab-btn.active{background:var(--tab-active);color:var(--text-main);box-shadow:0 2px 8px rgba(0,0,0,.1);}
.tab-btn:hover:not(.active){color:var(--text-main);background:rgba(59,130,246,.06);}
.tab-btn i{font-size:15px;}

.modules-grid{display:grid;grid-template-columns:repeat(4,1fr);gap:16px;width:100%;max-width:1040px;}
@media(max-width:900px){.modules-grid{grid-template-columns:repeat(3,1fr);}}
@media(max-width:620px){.modules-grid{grid-template-columns:repeat(2,1fr);}}

.mod-card{position:relative;background:var(--bg-card);border:1px solid var(--border-soft);border-radius:16px;padding:22px 18px 18px;text-decoration:none !important;display:flex;flex-direction:column;align-items:flex-start;overflow:hidden;cursor:pointer;transition:transform .28s cubic-bezier(.4,0,.2,1),box-shadow .28s,border-color .28s,background .35s;}
.mod-card::after{content:'';position:absolute;top:-60%;left:-80%;width:60%;height:220%;background:var(--shine);transform:skewX(-18deg);transition:left .55s;pointer-events:none;}
.mod-card:hover::after{left:150%;}
.mod-card::before{content:'';position:absolute;top:-28px;right:-28px;width:90px;height:90px;border-radius:50%;background:radial-gradient(circle,var(--ma,var(--primary)) 0%,transparent 70%);opacity:.07;transition:opacity .3s,transform .3s;}
.mod-card:hover::before{opacity:.15;transform:scale(1.25);}
.mod-card:hover{transform:translateY(-4px) scale(1.015);box-shadow:var(--shadow-hover);border-color:color-mix(in srgb,var(--ma,var(--primary)) 40%,transparent);}
.mod-icon{width:46px;height:46px;border-radius:12px;display:flex;align-items:center;justify-content:center;font-size:20px;margin-bottom:12px;position:relative;z-index:1;transition:transform .25s;}
.mod-card:hover .mod-icon{transform:scale(1.1) rotate(-4deg);}
.mod-name{font-size:13.5px;font-weight:700;color:var(--text-main);margin-bottom:4px;position:relative;z-index:1;transition:color .3s;}
.mod-card:hover .mod-name{color:var(--ma,var(--primary));}
.mod-desc{font-size:11px;line-height:1.5;color:var(--text-muted);position:relative;z-index:1;}
.mod-arrow{position:absolute;bottom:14px;right:16px;font-size:13px;color:var(--text-muted);opacity:0;transform:translateX(-5px);transition:opacity .25s,transform .25s,color .25s;z-index:1;}
.mod-card:hover .mod-arrow{opacity:1;transform:translateX(0);color:var(--ma,var(--primary));}
.mod-badge{position:absolute;top:11px;right:11px;color:#fff;font-size:9px;font-weight:700;letter-spacing:.4px;text-transform:uppercase;padding:2px 7px;border-radius:6px;z-index:2;background:var(--success);}

.c-blue{--ma:#3b82f6}.c-green{--ma:#10b981}.c-purp{--ma:#8b5cf6}.c-amber{--ma:#f59e0b}.c-pink{--ma:#ec4899}.c-cyan{--ma:#06b6d4}.c-ora{--ma:#f97316}.c-red{--ma:#ef4444}.c-teal{--ma:#14b8a6}.c-indigo{--ma:#6366f1}.c-rose{--ma:#f43f5e}.c-purple{--ma:#7c3aed}.c-lime{--ma:#65a30d}.c-orange{--ma:#ea580c}
[data-theme="dark"] .c-blue{--ma:#60a5fa}[data-theme="dark"] .c-green{--ma:#34d399}[data-theme="dark"] .c-purp{--ma:#a78bfa}[data-theme="dark"] .c-amber{--ma:#fbbf24}[data-theme="dark"] .c-pink{--ma:#f472b6}[data-theme="dark"] .c-cyan{--ma:#22d3ee}[data-theme="dark"] .c-ora{--ma:#fb923c}[data-theme="dark"] .c-red{--ma:#f87171}[data-theme="dark"] .c-teal{--ma:#2dd4bf}[data-theme="dark"] .c-indigo{--ma:#818cf8}[data-theme="dark"] .c-rose{--ma:#fb7185}[data-theme="dark"] .c-purple{--ma:#a78bfa}[data-theme="dark"] .c-lime{--ma:#84cc16}[data-theme="dark"] .c-orange{--ma:#fb923c}

.ib{border-radius:12px;display:flex;align-items:center;justify-content:center;}
.ib-blue{background:rgba(59,130,246,.12);color:#3b82f6;}
.ib-green{background:rgba(16,185,129,.12);color:#10b981;}
.ib-purp{background:rgba(139,92,246,.12);color:#8b5cf6;}
.ib-amber{background:rgba(245,158,11,.12);color:#f59e0b;}
.ib-pink{background:rgba(236,72,153,.12);color:#ec4899;}
.ib-cyan{background:rgba(6,182,212,.12);color:#06b6d4;}
.ib-ora{background:rgba(249,115,22,.12);color:#f97316;}
.ib-red{background:rgba(239,68,68,.12);color:#ef4444;}
.ib-teal{background:rgba(20,184,166,.12);color:#14b8a6;}
.ib-indigo{background:rgba(99,102,241,.12);color:#6366f1;}
.ib-rose{background:rgba(244,63,94,.12);color:#f43f5e;}
[data-theme="dark"] .ib-blue{background:rgba(96,165,250,.15);color:#60a5fa;}
[data-theme="dark"] .ib-green{background:rgba(52,211,153,.15);color:#34d399;}
[data-theme="dark"] .ib-purp{background:rgba(167,139,250,.15);color:#a78bfa;}
[data-theme="dark"] .ib-amber{background:rgba(251,191,36,.15);color:#fbbf24;}
[data-theme="dark"] .ib-pink{background:rgba(244,114,182,.15);color:#f472b6;}
[data-theme="dark"] .ib-cyan{background:rgba(34,211,238,.15);color:#22d3ee;}
[data-theme="dark"] .ib-ora{background:rgba(251,146,60,.15);color:#fb923c;}
[data-theme="dark"] .ib-red{background:rgba(248,113,113,.15);color:#f87171;}
[data-theme="dark"] .ib-teal{background:rgba(45,212,191,.15);color:#2dd4bf;}
[data-theme="dark"] .ib-indigo{background:rgba(129,140,248,.15);color:#818cf8;}
[data-theme="dark"] .ib-rose{background:rgba(251,113,133,.15);color:#fb7185;}
.ib-purple{background:rgba(124,58,237,.12);color:#7c3aed;}.ib-lime{background:rgba(101,163,13,.12);color:#65a30d;}.ib-orange{background:rgba(234,88,12,.12);color:#ea580c;}
[data-theme="dark"] .ib-purple{background:rgba(167,139,250,.15);color:#a78bfa;}[data-theme="dark"] .ib-lime{background:rgba(132,204,22,.15);color:#84cc16;}[data-theme="dark"] .ib-orange{background:rgba(251,146,60,.15);color:#fb923c;}
/* Modales portal empleado */
.portal-modal-overlay{display:none;position:fixed;inset:0;background:rgba(0,0,0,.45);z-index:9999;align-items:center;justify-content:center;}
.portal-modal-overlay.show{display:flex;}
.portal-modal{background:var(--bg-card,#fff);border-radius:16px;padding:28px 28px 24px;width:100%;max-width:480px;box-shadow:0 8px 40px rgba(0,0,0,.18);position:relative;}
.portal-modal h3{font-size:17px;font-weight:700;margin:0 0 18px;display:flex;align-items:center;gap:8px;}
.portal-modal label{font-size:12px;font-weight:600;color:#64748b;display:block;margin-bottom:5px;margin-top:12px;}
.portal-modal input,.portal-modal textarea,.portal-modal select{width:100%;border:1.5px solid #e2e8f0;border-radius:8px;padding:9px 12px;font-size:13px;background:var(--bg-main,#f5f7fa);color:var(--text-main,#1e293b);outline:none;transition:border-color .2s;box-sizing:border-box;}
.portal-modal input:focus,.portal-modal textarea:focus,.portal-modal select:focus{border-color:#6366f1;}
.portal-modal .star-row{display:flex;gap:10px;margin:10px 0;position:relative;}
.portal-modal .star-btn{font-size:34px;background:none;border:none;cursor:pointer;color:#d1d5db;transition:color .18s,transform .18s;padding:2px;position:relative;line-height:1;}
.portal-modal .star-btn:hover{transform:scale(1.25);}
.portal-modal .star-btn.active{color:#f59e0b;}
.portal-modal .star-btn.pop{animation:starPop .38s cubic-bezier(.34,1.56,.64,1);}
@keyframes starPop{0%{transform:scale(1)}40%{transform:scale(1.55)}70%{transform:scale(.88)}100%{transform:scale(1)}}

/* Particles */
.star-particle{position:fixed;pointer-events:none;font-size:16px;z-index:99999;animation:particleFly .7s ease-out forwards;}
@keyframes particleFly{0%{opacity:1;transform:translate(0,0) scale(1)}100%{opacity:0;transform:translate(var(--tx),var(--ty)) scale(.3)}}
.portal-modal .pm-actions{display:flex;gap:10px;margin-top:20px;justify-content:flex-end;}
.portal-modal .pm-btn{padding:9px 22px;border-radius:8px;font-size:13px;font-weight:600;cursor:pointer;border:none;transition:opacity .2s;}
.portal-modal .pm-btn-primary{background:#6366f1;color:#fff;}.portal-modal .pm-btn-primary:hover{opacity:.88;}
.portal-modal .pm-btn-secondary{background:#f1f5f9;color:#475569;}.portal-modal .pm-btn-secondary:hover{background:#e2e8f0;}
.portal-modal .pm-close{position:absolute;top:14px;right:16px;background:none;border:none;font-size:18px;cursor:pointer;color:#94a3b8;}
.portal-modal .pm-success{display:none;text-align:center;padding:16px 0 8px;}
.portal-modal .pm-success i{font-size:40px;color:#10b981;}
.portal-modal .pm-success p{font-size:14px;margin:10px 0 0;color:#374151;font-weight:500;}

.tab-panel{display:none;width:100%;max-width:1040px;}
.tab-panel.active{display:block;}
.section-label{font-size:11px;font-weight:700;color:var(--text-muted);letter-spacing:1.1px;text-transform:uppercase;margin-bottom:12px;padding-left:2px;}

.sidebar-overlay{position:fixed;inset:0;background:rgba(0,0,0,.4);z-index:200;opacity:0;pointer-events:none;transition:opacity .3s;}
.sidebar-overlay.open{opacity:1;pointer-events:all;}
.itsm-sidebar{position:fixed;top:0;right:-340px;width:320px;height:100vh;background:var(--sidebar-bg);border-left:1px solid var(--border-soft);z-index:201;transition:right .35s cubic-bezier(.4,0,.2,1);display:flex;flex-direction:column;box-shadow:-8px 0 32px rgba(0,0,0,.15);}
.itsm-sidebar.open{right:0;}
.sb-header{padding:20px;border-bottom:1px solid var(--border-soft);display:flex;align-items:center;justify-content:space-between;}
.sb-title{font-size:15px;font-weight:700;color:var(--text-main);}
.sb-sub{font-size:11px;color:var(--text-muted);margin-top:2px;}
.sb-close{width:32px;height:32px;border-radius:8px;border:1px solid var(--border-soft);background:transparent;cursor:pointer;display:flex;align-items:center;justify-content:center;color:var(--text-muted);font-size:15px;transition:all .2s;}
.sb-close:hover{background:var(--bg-main);color:var(--text-main);}
.sb-body{flex:1;overflow-y:auto;padding:14px;}
.sb-item{display:flex;align-items:center;gap:12px;padding:13px 14px;border-radius:12px;cursor:pointer;border:1px solid transparent;margin-bottom:8px;text-decoration:none;transition:all .2s;}
.sb-item:hover{background:color-mix(in srgb,var(--sc) 8%,transparent);border-color:color-mix(in srgb,var(--sc) 28%,transparent);}
.sb-item-icon{width:40px;height:40px;border-radius:10px;display:flex;align-items:center;justify-content:center;font-size:18px;flex-shrink:0;transition:transform .2s;}
.sb-item:hover .sb-item-icon{transform:scale(1.08);}
.sb-item-name{font-size:13.5px;font-weight:600;color:var(--text-main);}
.sb-item-desc{font-size:11px;color:var(--text-muted);margin-top:2px;}
.sb-arrow{margin-left:auto;font-size:12px;color:var(--text-muted);opacity:0;transition:opacity .2s,transform .2s;}
.sb-item:hover .sb-arrow{opacity:1;transform:translateX(3px);}
.si1{--sc:#ef4444}.si2{--sc:#3b82f6}.si3{--sc:#f59e0b}.si4{--sc:#8b5cf6}.si5{--sc:#10b981}
[data-theme="dark"] .si1{--sc:#f87171}[data-theme="dark"] .si2{--sc:#60a5fa}[data-theme="dark"] .si3{--sc:#fbbf24}[data-theme="dark"] .si4{--sc:#a78bfa}[data-theme="dark"] .si5{--sc:#34d399}

.home-footer{margin-top:36px;text-align:center;font-size:11px;color:var(--text-muted);font-family:monospace;opacity:.7;}
.mx-kpi{background:var(--bg-card);border:1px solid var(--border-soft);border-radius:12px;padding:16px 18px;display:flex;flex-direction:column;gap:6px;}
.mx-kpi-val{font-size:28px;font-weight:800;color:var(--text-main);line-height:1;}
.mx-kpi-lbl{font-size:11px;font-weight:600;color:var(--text-muted);display:flex;align-items:center;gap:5px;}
.mx-tr:hover{background:rgba(59,130,246,.04);}
.mx-badge{display:inline-block;padding:2px 9px;border-radius:6px;font-size:12px;font-weight:700;}
.portal-back-btn{position:fixed;bottom:22px;left:22px;z-index:9000;display:flex;align-items:center;gap:8px;background:var(--primary);color:#fff;border:none;border-radius:30px;padding:10px 20px;font-size:13px;font-weight:700;cursor:pointer;box-shadow:0 4px 18px rgba(59,130,246,.4);text-decoration:none;transition:transform .2s,box-shadow .2s;}
.portal-back-btn:hover{transform:translateY(-2px);box-shadow:0 8px 24px rgba(59,130,246,.5);color:#fff;}

/* MARQUESINA */
.marquee-wrap{width:100%;max-width:1040px;margin-bottom:16px;border-radius:14px;display:none;overflow:hidden;}
.marquee-wrap.has-banners{display:block;}
.marquee-track{width:100%;overflow:hidden;padding:16px 0;display:block;}
.marquee-inner{display:flex;gap:0;white-space:nowrap;animation:mq-scroll 22s linear infinite;width:max-content;}
.marquee-inner:hover{animation-play-state:paused;}
.marquee-item{display:inline-flex;align-items:center;gap:10px;padding:0 28px;font-size:15px;font-weight:800;font-style:italic;white-space:nowrap;letter-spacing:.01em;}
.marquee-sep{opacity:.35;margin:0 14px;font-size:15px;font-weight:800;}
.mq-critical{background:linear-gradient(90deg,#fef2f2,#fee2e2);color:#b91c1c;border:1px solid #fca5a5;}
.mq-warning {background:linear-gradient(90deg,#fffbeb,#fef3c7);color:#92400e;border:1px solid #fcd34d;}
.mq-info    {background:linear-gradient(90deg,#eff6ff,#dbeafe);color:#1e40af;border:1px solid #93c5fd;}
.mq-success {background:linear-gradient(90deg,#f0fdf4,#dcfce7);color:#166534;border:1px solid #86efac;}
[data-theme="dark"] .mq-critical{background:linear-gradient(90deg,#450a0a,#7f1d1d);color:#fca5a5;border-color:#dc2626;}
[data-theme="dark"] .mq-warning {background:linear-gradient(90deg,#451a03,#78350f);color:#fcd34d;border-color:#d97706;}
[data-theme="dark"] .mq-info    {background:linear-gradient(90deg,#0c1a3a,#1e3a5f);color:#93c5fd;border-color:#2563eb;}
[data-theme="dark"] .mq-success {background:linear-gradient(90deg,#052e16,#14532d);color:#86efac;border-color:#16a34a;}
@keyframes mq-scroll{0%{transform:translateX(0)}100%{transform:translateX(-50%)}}

/* CHATBOT */
.cb-container{position:fixed;bottom:24px;right:24px;z-index:9997;display:none;}
.cb-container.cb-visible{display:block;}
.cb-btn{width:60px;height:60px;border-radius:50%;background:linear-gradient(135deg,#1e3a5f,#2563eb);border:none;box-shadow:0 4px 20px rgba(37,99,235,.45);cursor:pointer;display:flex;align-items:center;justify-content:center;transition:all .3s;position:relative;}
.cb-btn:hover{transform:scale(1.1);box-shadow:0 6px 28px rgba(37,99,235,.6);}
.cb-btn i{color:#fff;font-size:26px;}
.cb-btn-pulse{position:absolute;inset:0;border-radius:50%;background:rgba(37,99,235,.35);animation:cbPulse 2.2s ease-out infinite;}
@keyframes cbPulse{0%{transform:scale(1);opacity:.7}70%{transform:scale(1.55);opacity:0}100%{opacity:0}}
.cb-window{position:absolute;bottom:74px;right:0;width:380px;height:520px;background:#fff;border-radius:20px;box-shadow:0 16px 56px rgba(0,0,0,.2);display:none;flex-direction:column;overflow:hidden;}
[data-theme="dark"] .cb-window{background:#0f1e35;}
.cb-window.active{display:flex;animation:cbUp .3s cubic-bezier(.34,1.56,.64,1);}
@keyframes cbUp{from{opacity:0;transform:translateY(18px) scale(.96)}to{opacity:1;transform:translateY(0) scale(1)}}
@keyframes cbUp{from{opacity:0;transform:translateY(16px)}to{opacity:1;transform:translateY(0)}}
.cb-header{background:linear-gradient(135deg,#1e3a5f,#2563eb,#0ea5e9);padding:14px 18px;display:flex;align-items:center;justify-content:space-between;flex-shrink:0;}
.cb-hinfo{display:flex;align-items:center;gap:12px;}
.cb-avatar{width:40px;height:40px;border-radius:50%;background:rgba(255,255,255,.15);border:2px solid rgba(255,255,255,.3);display:flex;align-items:center;justify-content:center;flex-shrink:0;}
.cb-avatar i{color:#fff;font-size:20px;}
.cb-htitle h4{margin:0;font-size:14px;font-weight:800;color:#fff;letter-spacing:.2px;}
.cb-htitle p{margin:0;font-size:11px;color:rgba(255,255,255,.8);display:flex;align-items:center;gap:5px;}
.cb-online-dot{width:7px;height:7px;background:#4ade80;border-radius:50%;display:inline-block;animation:cbPulse 2s ease-out infinite;}
.cb-htitle-sub{font-size:11px;color:rgba(255,255,255,.65);margin-top:1px;}
.cb-x{background:rgba(255,255,255,.15);border:none;color:#fff;cursor:pointer;font-size:15px;padding:6px;border-radius:50%;width:30px;height:30px;display:flex;align-items:center;justify-content:center;transition:background .2s;}
.cb-x:hover{background:rgba(255,255,255,.28);}
.cb-msgs{flex:1;padding:16px;overflow-y:auto;background:#f4f6fb;display:flex;flex-direction:column;gap:10px;}
[data-theme="dark"] .cb-msgs{background:#0b1120;}
.cb-msgs::-webkit-scrollbar{width:4px;}
.cb-msgs::-webkit-scrollbar-thumb{background:#d1d5db;border-radius:2px;}
[data-theme="dark"] .cb-msgs::-webkit-scrollbar-thumb{background:#334155;}
.msg{display:flex;animation:msgIn .28s ease;}
@keyframes msgIn{from{opacity:0;transform:translateY(6px)}to{opacity:1;transform:translateY(0)}}
.msg.bot{justify-content:flex-start;}
.msg.user{justify-content:flex-end;}
.msg-c{max-width:78%;padding:10px 14px;border-radius:15px;font-size:13px;line-height:1.5;}
.msg.bot .msg-c{background:#fff;color:#1e293b;border-bottom-left-radius:3px;box-shadow:0 1px 4px rgba(0,0,0,.07);}
[data-theme="dark"] .msg.bot .msg-c{background:#1e3050;color:#e2e8f0;}
.msg.user .msg-c{background:linear-gradient(135deg,#1e3a5f,#2563eb);color:#fff;border-bottom-right-radius:3px;}
.qopts{display:flex;flex-wrap:wrap;gap:6px;margin-top:10px;}
.qopt{background:#fff;border:1.5px solid #2563eb;color:#2563eb;padding:6px 13px;border-radius:20px;font-size:12px;font-weight:600;cursor:pointer;transition:all .2s;}
[data-theme="dark"] .qopt{background:#0f1e35;border-color:#60a5fa;color:#60a5fa;}
.qopt:hover{background:#2563eb;color:#fff;transform:translateY(-1px);}
[data-theme="dark"] .qopt:hover{background:#1d4ed8;color:#fff;border-color:#1d4ed8;}
.dots{display:flex;gap:4px;padding:3px 1px;}
.dots span{width:7px;height:7px;background:#2563eb;border-radius:50%;animation:bounce 1.3s infinite;}
.dots span:nth-child(2){animation-delay:.2s;}
.dots span:nth-child(3){animation-delay:.4s;}
@keyframes bounce{0%,60%,100%{transform:translateY(0);opacity:.7}30%{transform:translateY(-7px);opacity:1}}
.cb-input-area{padding:12px;background:#fff;border-top:1px solid #e9ecef;display:flex;gap:9px;flex-shrink:0;}
[data-theme="dark"] .cb-input-area{background:#131f35;border-top:1px solid #1e3050;}
.cb-input{flex:1;border:1px solid #dee2e6;border-radius:22px;padding:8px 16px;font-size:13px;outline:none;font-family:inherit;background:#fff;color:#1e293b;transition:border-color .25s;}
[data-theme="dark"] .cb-input{background:#0b1120;border-color:#1e3050;color:#e2e8f0;}
.cb-input:focus{border-color:#2563eb;}
.cb-send{width:38px;height:38px;border-radius:50%;background:linear-gradient(135deg,#1e3a5f,#2563eb);border:none;color:#fff;cursor:pointer;display:flex;align-items:center;justify-content:center;flex-shrink:0;transition:all .25s;}
.cb-send:hover{transform:scale(1.07);box-shadow:0 4px 12px rgba(37,99,235,.4);}

@keyframes fadeDown{from{opacity:0;transform:translateY(-20px)}to{opacity:1;transform:translateY(0)}}
@media(max-width:500px){.cb-window{width:calc(100vw - 28px);right:-8px;}}

/* ── Identify Box ─────────────────────────────────────────────────────────── */
.identify-box{width:100%;max-width:520px;background:var(--bg-card);border:1px solid var(--border-soft);border-radius:20px;padding:28px 32px;margin-bottom:24px;box-shadow:var(--shadow-card);text-align:center;}
.identify-title{font-size:16px;font-weight:700;color:var(--text-main);margin-bottom:5px;}
.identify-sub{font-size:12.5px;color:var(--text-muted);margin-bottom:20px;line-height:1.5;}
.id-input-row{display:flex;gap:10px;align-items:flex-start;position:relative;}
.id-ac-wrap{flex:1;position:relative;}
.id-field{width:100%;border:1.5px solid var(--border-soft);border-radius:12px;padding:10px 14px;font-size:13.5px;background:var(--bg-card);color:var(--text-main);outline:none;transition:border-color .2s;font-family:inherit;}
.id-field:focus{border-color:var(--primary);}
.id-btn{padding:10px 20px;background:var(--primary);color:#fff;border:none;border-radius:12px;font-size:13px;font-weight:600;cursor:pointer;white-space:nowrap;transition:all .2s;flex-shrink:0;}
.id-btn:hover{opacity:.88;transform:translateY(-1px);}
.id-btn:disabled{opacity:.5;cursor:not-allowed;transform:none;}
.ac-drop{position:absolute;top:calc(100% + 4px);left:0;right:0;background:var(--bg-card);border:1px solid var(--border-soft);border-radius:12px;box-shadow:0 8px 24px rgba(0,0,0,.12);z-index:100;overflow:hidden;display:none;}
.ac-item{padding:10px 14px;cursor:pointer;font-size:13px;color:var(--text-main);display:flex;flex-direction:column;gap:2px;transition:background .15s;text-align:left;}
.ac-item:hover,.ac-item.active{background:var(--bg-main);}
.ac-item small{color:var(--text-muted);font-size:11px;}
.id-status{margin-top:14px;padding:10px 14px;border-radius:10px;font-size:13px;display:none;text-align:left;}
.id-status.ok{background:rgba(16,185,129,.1);color:#059669;border:1px solid rgba(16,185,129,.25);}
.id-status.err{background:rgba(239,68,68,.1);color:#dc2626;border:1px solid rgba(239,68,68,.25);}
.id-status.info{background:rgba(59,130,246,.1);color:#2563eb;border:1px solid rgba(59,130,246,.25);}
/* Catalog section shown to employees after identify */
.cat-section{width:100%;max-width:1040px;}
.cat-welcome{margin-bottom:20px;padding:16px 20px;background:var(--bg-card);border:1px solid var(--border-soft);border-radius:14px;display:flex;align-items:center;gap:14px;}
.cat-avatar{width:46px;height:46px;border-radius:12px;background:linear-gradient(135deg,var(--primary),var(--info));display:flex;align-items:center;justify-content:center;font-size:20px;color:#fff;flex-shrink:0;}
.cat-welcome-name{font-size:15px;font-weight:700;color:var(--text-main);}
.cat-welcome-sub{font-size:12px;color:var(--text-muted);margin-top:2px;}
</style>
</head>
