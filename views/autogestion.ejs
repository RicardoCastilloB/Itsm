function cbHandleKnowMe(txt){
  _cbKnowData[_KNOW_ME_STEPS[_cbKnowStep].key] = txt;
  _cbKnowStep++;
  cbShowTyping();
  setTimeout(function(){
    cbHideTyping();
    if(_cbKnowStep < _KNOW_ME_STEPS.length){
      cbAddMsg(_KNOW_ME_STEPS[_cbKnowStep].ask, 'bot');
    } else {
      _cbFlow = null;
      var name = (_cbName||'').split(' ')[0] || 'usuario';
      cbAddMsg(`¡Muchas gracias, <strong>${name}</strong>! 💙✨<br><br>Hemos guardado tus respuestas:<br>
        <div style="background:#f0f9ff;border-left:3px solid #0ea5e9;border-radius:6px;padding:10px 14px;margin-top:8px;font-size:12px;line-height:1.8;">
          🎂 <strong>Cumpleaños:</strong> ${_cbKnowData.birthday||'—'}<br>
          🏢 <strong>Área:</strong> ${_cbKnowData.area||'—'}<br>
          💡 <strong>Necesita:</strong> ${_cbKnowData.daily||'—'}
        </div>
        <br>Con esta información podré asistirte de forma más personalizada. ¡Gracias por compartirlo! 🚀`, 'bot');
      setTimeout(cbShowMenu, 1500);
    }
  }, 800);
}

function cbAddMsg(html, who){
  const d = document.createElement('div');
  d.className = 'msg ' + who;
  const c = document.createElement('div');
  c.className = 'msg-c';
  c.innerHTML = html;
  d.appendChild(c);
  cbMsgs.appendChild(d);
  cbMsgs.scrollTop = cbMsgs.scrollHeight;
}
function cbShowTyping(){
  const d = document.createElement('div');
  d.className = 'msg bot'; d.id = 'ariaTyping';
  d.innerHTML = '<div class="msg-c"><div class="dots"><span></span><span></span><span></span></div></div>';
