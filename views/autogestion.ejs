var _cbFlow     = null;   // null | 'know_me'
var _cbKnowStep = 0;
var _cbKnowData = {};

const _KNOW_ME_STEPS = [
  { key:'birthday', ask:'¡Me encanta conocerte mejor! 🌟<br>Cuéntame, ¿cuándo es tu cumpleaños? 🎂<br><span style="font-size:11px;color:#94a3b8;">(Ej. 15 de marzo)</span>' },
