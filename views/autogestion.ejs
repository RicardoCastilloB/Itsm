<script>
(function(){
  const s=localStorage.getItem('dashboardTheme')||'light';
  document.documentElement.setAttribute('data-theme',s);
  updateToggleUI(s);
})();
function toggleTheme(){
  const n=document.documentElement.getAttribute('data-theme')==='dark'?'light':'dark';
  document.documentElement.setAttribute('data-theme',n);
  localStorage.setItem('dashboardTheme',n);
  updateToggleUI(n);
}
function updateToggleUI(t){
  document.getElementById('toggleIcon').className=t==='dark'?'bi bi-sun-fill toggle-icon':'bi bi-moon-stars-fill toggle-icon';
  document.getElementById('toggleLabel').textContent=t==='dark'?'Claro':'Oscuro';
}
function switchTab(t){
  document.querySelectorAll('.tab-btn').forEach(b=>b.classList.remove('active'));
  document.querySelectorAll('.tab-panel').forEach(p=>p.classList.remove('active'));
  document.getElementById('tb-'+t).classList.add('active');
  document.getElementById('panel-'+t).classList.add('active');
}
function openSB(e){e.preventDefault();document.getElementById('itsmSB').classList.add('open');document.getElementById('sbOverlay').classList.add('open');document.body.style.overflow='hidden';}
function closeSB(){document.getElementById('itsmSB').classList.remove('open');document.getElementById('sbOverlay').classList.remove('open');document.body.style.overflow='';}

// ── IDENTIFICATION FLOW ────────────────────────────────────────────────────
let _acItems=[], _acIdx=-1, _acTimer=null;
const _identBox = document.getElementById('identifyBox');

function acIdentDebounce(){
  clearTimeout(_acTimer);
  _acTimer = setTimeout(acIdentFetch, 280);
  document.getElementById('identDrop').style.display='none';
}

async function acIdentFetch(){
  const q = (document.getElementById('identEmail')?.value||'').trim();
  const drop = document.getElementById('identDrop');
  if(!drop) return;
  if(q.length < 2){ drop.style.display='none'; return; }
  try{
    const r = await fetch(`/api/employees/search-emails?q=${encodeURIComponent(q)}`,{credentials:'include'});
    const d = await r.json();
    _acItems = (d.data||[]).slice(0,8);
    _acIdx = -1;
    if(!_acItems.length){ drop.style.display='none'; return; }
    drop.innerHTML = _acItems.map((it,i)=>`<div class="ac-item" data-idx="${i}" onmousedown="acIdentPick(${i})">
      <span>${it.full_name||it.email}</span><small>${it.email}${it.position_name?' · '+it.position_name:''}</small>
    </div>`).join('');
    drop.style.display='block';
  }catch(e){ drop.style.display='none'; }
}

function acIdentPick(i){
  const it = _acItems[i];
  if(!it) return;
  document.getElementById('identEmail').value = it.email;
  document.getElementById('identDrop').style.display='none';
}

function acIdentKey(e){
  const drop = document.getElementById('identDrop');
  const items = drop?.querySelectorAll('.ac-item');
  if(!items?.length) { if(e.key==='Enter') identificar(); return; }
  if(e.key==='ArrowDown'){ e.preventDefault(); _acIdx=Math.min(_acIdx+1,items.length-1); items.forEach((el,i)=>el.classList.toggle('active',i===_acIdx)); }
  else if(e.key==='ArrowUp'){ e.preventDefault(); _acIdx=Math.max(_acIdx-1,0); items.forEach((el,i)=>el.classList.toggle('active',i===_acIdx)); }
  else if(e.key==='Enter'){ e.preventDefault(); if(_acIdx>=0){ acIdentPick(_acIdx); drop.style.display='none'; } else{ drop.style.display='none'; identificar(); } }
  else if(e.key==='Escape'){ drop.style.display='none'; }
}

document.addEventListener('click', e=>{
  const drop = document.getElementById('identDrop');
  if(drop && !document.getElementById('identEmail')?.contains(e.target) && !drop.contains(e.target)){
    drop.style.display='none';
  }
});

async function identificar(){
  const emailEl = document.getElementById('identEmail');
  const statusEl = document.getElementById('identStatus');
  const btn = document.getElementById('identBtn');
  if(!emailEl || !statusEl) return;

  const email = emailEl.value.trim();
  if(!email){ setIdentStatus('err','Ingrese un correo electrónico.'); return; }

  btn.disabled = true;
  btn.innerHTML = '<i class="bi bi-hourglass-split"></i> Verificando...';
  statusEl.style.display = 'none';

  try{
    const r = await fetch('/api/portal/identify', {
      method:'POST', credentials:'include',
      headers:{'Content-Type':'application/json'},
      body: JSON.stringify({email})
    });
    const d = await r.json();

    if(!d.success){
      setIdentStatus('err', d.error || 'Correo no encontrado. Solo se permite el dominio @integratel.com.pe');
      return;
    }

    // Persist email for cross-page use
    const resolvedName = d.name || email;
    localStorage.setItem('portal_user_email', email);
    localStorage.setItem('portal_user_name', resolvedName);

    // Log activity (non-blocking)
    fetch('/api/portal/activity-log', {
      method:'POST', credentials:'include',
      headers:{'Content-Type':'application/json'},
      body: JSON.stringify({ email, action: 'identify', page: 'autogestion', metadata: { type: d.type, name: d.name } })
    }).catch(()=>{});

    if(d.type === 'admin'){
      setIdentStatus('ok', `<i class="bi bi-shield-check-fill"></i> Bienvenido, <strong>${d.name}</strong>. Acceso completo habilitado.`);
      setTimeout(()=>{
        if(_identBox) _identBox.style.display='none';
        applyReporterLinks(email);
        showFullTabs();
      }, 900);
    } else if(d.type === 'employee' || d.type === 'new_registered'){
      const msg = d.type==='new_registered'
        ? `<i class="bi bi-envelope-check-fill"></i> Correo registrado. Te enviamos un correo de bienvenida a <strong>${email}</strong>.`
        : `<i class="bi bi-check-circle-fill"></i> Bienvenido, <strong>${d.name}</strong>. Acceso al catálogo habilitado.`;
      setIdentStatus('info', msg);
      setTimeout(()=>{
        if(_identBox) _identBox.style.display='none';
        applyReporterLinks(email);
        showCatalog(d.name || email, d.type === 'new_registered');
      }, 1100);
    }
  }catch(err){
    setIdentStatus('err', 'Error de conexión. Intente nuevamente.');
  } finally{
    btn.disabled = false;
    btn.innerHTML = '<i class="bi bi-arrow-right-circle-fill"></i> Ingresar';
  }
}

function applyReporterLinks(email){
  const enc  = encodeURIComponent(email);
  const name = localStorage.getItem('portal_user_name') || email;
  const encN = encodeURIComponent(name);
  document.querySelectorAll('a[data-reporter-link]').forEach(a => {
    const base = a.dataset.href;
    const sep  = base.includes('?') ? '&' : '?';
    a.href = base + sep + 'reporter=' + enc + '&name=' + encN;
  });
}

// On page load: restore session from localStorage
(function restorePortalSession(){
  const savedEmail = localStorage.getItem('portal_user_email');
  const savedName  = localStorage.getItem('portal_user_name');
  if(!savedEmail) return;
  const emailEl = document.getElementById('identEmail');
  if(emailEl) emailEl.value = savedEmail;
  applyReporterLinks(savedEmail);
  cbShow(savedEmail, savedName || savedEmail);
  // Show a restore banner instead of forcing re-entry
  const statusEl = document.getElementById('identStatus');
  if(statusEl){
    statusEl.className = 'id-status info';
    statusEl.innerHTML = `<i class="bi bi-person-check-fill"></i> Sesión restaurada: <strong>${savedEmail}</strong>. <a href="#" onclick="clearPortalSession();return false;" style="color:inherit;text-decoration:underline;">No soy yo</a>`;
    statusEl.style.display = 'block';
  }
})();

function clearPortalSession(){
  localStorage.removeItem('portal_user_email');
  localStorage.removeItem('portal_user_name');
  const emailEl = document.getElementById('identEmail');
  if(emailEl) emailEl.value = '';
  const statusEl = document.getElementById('identStatus');
