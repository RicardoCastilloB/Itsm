// ── MARQUESINA ─────────────────────────────────────────────────────────────
const _mqIcons = { critical:'bi-exclamation-triangle-fill', warning:'bi-exclamation-circle-fill', info:'bi-info-circle-fill', success:'bi-check-circle-fill' };
const _mqClass = { critical:'mq-critical', warning:'mq-warning', info:'mq-info', success:'mq-success' };

async function loadMarquee(){
  try {
    const r = await fetch('/api/portal/banners');
    const d = await r.json();
    if(!d.success || !d.data?.length) return;
    const wrap = document.getElementById('marqueeWrap');
    const inner = document.getElementById('marqueeInner');
    if(!wrap || !inner) return;
    // Build items (duplicated for seamless loop)
    const items = d.data.map(b => {
      const cls = _mqClass[b.severity] || 'mq-info';
      const ico = _mqIcons[b.severity] || 'bi-info-circle-fill';
      return `<span class="marquee-item ${cls}"><i class="bi ${ico}" style="font-size:16px;flex-shrink:0;"></i>${b.message}</span><span class="marquee-sep ${cls}">◆</span>`;
    }).join('');
    inner.innerHTML = items + items; // duplicate for infinite loop
    wrap.classList.add('has-banners');
    // Adjust animation speed by content length
    const totalLen = d.data.reduce((s,b)=>s+b.message.length,0);
    const dur = Math.max(14, Math.min(40, totalLen * 0.18));
    inner.style.animationDuration = dur + 's';
    // Apply dominant severity class to both wrap (border) and track (background)
    const track = document.getElementById('marqueeTrack');
    const dominant = d.data.find(b=>b.severity==='critical') || d.data.find(b=>b.severity==='warning') || d.data[0];
    const sevCls = _mqClass[dominant.severity] || 'mq-info';
    track.className = 'marquee-track ' + sevCls;
    wrap.className  = 'marquee-wrap has-banners ' + sevCls;
  } catch(e) {}
}
loadMarquee();

function openMarqueeAdmin(){
  document.getElementById('marqueeModalOverlay').classList.add('show');
  loadBannerList();
}

async function loadBannerList(){
  const list = document.getElementById('mqList');
  list.innerHTML = '<div style="text-align:center;padding:20px;color:var(--text-muted);font-size:13px;"><i class="bi bi-hourglass-split"></i> Cargando...</div>';
  try {
    const r = await fetch('/api/portal/banners?all=1', {credentials:'include'});
    const d = await r.json();
    if(!d.data?.length){ list.innerHTML='<div style="text-align:center;padding:20px;color:var(--text-muted);font-size:13px;">No hay avisos publicados</div>'; return; }
    list.innerHTML = d.data.map(b => {
      const cls = _mqClass[b.severity] || 'mq-info';
      const ico = _mqIcons[b.severity] || 'bi-info-circle-fill';
      const exp = b.expires_at ? ` · Expira: ${new Date(b.expires_at).toLocaleString('es-PE',{day:'2-digit',month:'short',hour:'2-digit',minute:'2-digit'})}` : '';
      return `<div style="display:flex;align-items:center;gap:10px;padding:10px 12px;border-radius:8px;border:1px solid var(--border-soft);background:var(--bg-card);">
        <span class="marquee-item ${cls}" style="flex:1;padding:5px 12px;border-radius:6px;font-size:12px;"><i class="bi ${ico}"></i>${b.message}</span>
        <span style="font-size:11px;color:var(--text-muted);white-space:nowrap;">${new Date(b.created_at).toLocaleString('es-PE',{day:'2-digit',month:'short',hour:'2-digit',minute:'2-digit'})}${exp}</span>
        <button onclick="deleteBanner(${b.id})" style="padding:4px 10px;border-radius:6px;border:1px solid #fca5a5;background:rgba(239,68,68,.08);color:#dc2626;cursor:pointer;font-size:12px;" title="Desactivar"><i class="bi bi-trash3"></i></button>
      </div>`;
    }).join('');
  } catch(e) { list.innerHTML='<div style="color:var(--danger);padding:12px;">Error al cargar avisos</div>'; }
}

async function submitBanner(){
  const msg = document.getElementById('mqMsg').value.trim();
  const severity = document.getElementById('mqSeverity').value;
  const expires = document.getElementById('mqExpires').value;
  if(!msg){ alert('Escribe el texto del aviso'); return; }
  try {
    const r = await fetch('/api/portal/banners', {
      method:'POST', credentials:'include',
      headers:{'Content-Type':'application/json'},
      body: JSON.stringify({ message: msg, severity, expires_at: expires || null })
    });
    const d = await r.json();
    if(d.success){
      document.getElementById('mqMsg').value = '';
      document.getElementById('mqExpires').value = '';
      loadBannerList();
      loadMarquee();
    } else alert(d.error || 'Error al publicar');
  } catch(e) { alert('Error de conexión'); }
}

async function deleteBanner(id){
  if(!confirm('¿Desactivar este aviso?')) return;
  try {
    await fetch(`/api/portal/banners/${id}`, {method:'DELETE', credentials:'include'});
    loadBannerList();
    loadMarquee();
  } catch(e) {}
}

// ── MÉTRICAS PORTAL ────────────────────────────────────────────────────────
let _mxData = [];
async function loadPortalMetrics(){
  const from  = document.getElementById('mxFrom')?.value  || '';
  const to    = document.getElementById('mxTo')?.value    || '';
  const email = document.getElementById('mxEmail')?.value || '';
  const tbody = document.getElementById('mxTbody');
  if(tbody) tbody.innerHTML = '<tr><td colspan="6" style="text-align:center;padding:32px;color:var(--text-muted);"><i class="bi bi-hourglass-split"></i> Cargando...</td></tr>';
  try {
    const qs = new URLSearchParams();
    if(from)  qs.set('from',  from);
    if(to)    qs.set('to',    to);
    if(email) qs.set('email', email);
    const r = await fetch('/api/portal/activity-metrics?' + qs.toString(), { credentials:'include' });
    const d = await r.json();
    if(!d.success){ if(tbody) tbody.innerHTML='<tr><td colspan="6" style="text-align:center;padding:24px;color:var(--danger);">Error al cargar métricas</td></tr>'; return; }

    // KPIs
    const t = d.totals || {};
    const kv = (id, v) => { const el=document.getElementById(id); if(el) el.querySelector('.mx-kpi-val').textContent = v ?? 0; };
    kv('kpi-users',  t.unique_users);
    kv('kpi-logins', t.total_logins);
    kv('kpi-inc',    t.total_incidencias);
    kv('kpi-req',    t.total_requerimientos);
    kv('kpi-total',  t.total_actions);

    // Tabla
    _mxData = d.summary || [];
    const cnt = document.getElementById('mxCount');
    if(cnt) cnt.textContent = `(${_mxData.length} usuarios)`;
    renderMxTable();
  } catch(e) {
    if(tbody) tbody.innerHTML='<tr><td colspan="6" style="text-align:center;padding:24px;color:var(--danger);">Error de conexión</td></tr>';
  }
}

function renderMxTable(){
  const tbody = document.getElementById('mxTbody');
  if(!tbody) return;
  if(!_mxData.length){ tbody.innerHTML='<tr><td colspan="6" style="text-align:center;padding:32px;color:var(--text-muted);">Sin actividad registrada</td></tr>'; return; }
  tbody.innerHTML = _mxData.map(u => {
    const lastSeen = u.last_seen ? new Date(u.last_seen).toLocaleString('es-PE',{day:'2-digit',month:'short',year:'numeric',hour:'2-digit',minute:'2-digit'}) : '—';
    const incBadge = u.incidencias > 0 ? `<span class="mx-badge" style="background:rgba(239,68,68,.12);color:#dc2626;">${u.incidencias}</span>` : `<span style="color:var(--text-muted)">0</span>`;
    const reqBadge = u.requerimientos > 0 ? `<span class="mx-badge" style="background:rgba(59,130,246,.12);color:#2563eb;">${u.requerimientos}</span>` : `<span style="color:var(--text-muted)">0</span>`;
    return `<tr class="mx-tr" style="border-top:1px solid var(--border-soft);">
      <td style="padding:10px 16px;font-weight:600;color:var(--text-main);">${u.email}</td>
      <td style="padding:10px 12px;text-align:center;color:var(--text-muted);">${u.identifies ?? 0}</td>
      <td style="padding:10px 12px;text-align:center;">${incBadge}</td>
      <td style="padding:10px 12px;text-align:center;">${reqBadge}</td>
      <td style="padding:10px 12px;text-align:center;font-weight:700;color:var(--text-main);">${u.total}</td>
      <td style="padding:10px 16px;color:var(--text-muted);font-size:12px;">${lastSeen}</td>
    </tr>`;
  }).join('');
}

function exportMxCSV(){
  if(!_mxData.length){ alert('No hay datos para exportar'); return; }
  const rows = [['Correo','Accesos','Incidencias','Requerimientos','Total acciones','Última actividad']];
  _mxData.forEach(u => rows.push([u.email, u.identifies??0, u.incidencias??0, u.requerimientos??0, u.total, u.last_seen||'']));
  const csv = rows.map(r => r.map(v => `"${String(v).replace(/"/g,'""')}"`).join(',')).join('\n');
  const a = document.createElement('a');
  a.href = 'data:text/csv;charset=utf-8,\uFEFF' + encodeURIComponent(csv);
  a.download = `metricas-portal-${new Date().toISOString().slice(0,10)}.csv`;
  a.click();
}
</script>
