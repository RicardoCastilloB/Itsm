      cbAddMsg('🔐 <strong>Ver mis permisos</strong><br><br>Aquí podrás consultar todos los permisos y accesos asignados a tu usuario en los distintos sistemas y aplicaciones corporativas.<br><br><span style="background:#fef9c3;color:#854d0e;padding:4px 10px;border-radius:20px;font-size:11px;font-weight:700;">⏳ Próximamente disponible</span>', 'bot');
