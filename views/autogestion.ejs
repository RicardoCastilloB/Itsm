function cbDoAction(action){
  const enc  = encodeURIComponent(_cbEmail);
  const encN = encodeURIComponent(_cbName);
  const qs   = _cbEmail ? '?reporter='+enc+'&name='+encN : '';
  const urls = {
    open_incidencia:   '/incidencias'+qs,
    open_requerimiento:'/requerimientos'+qs,
    open_tickets:      '/home',
    open_faq:          '/preguntas-frecuentes'+qs
  };
  if(urls[action]) window.open(urls[action], '_blank');
}

async function cbSendMsg(){
  const txt = cbInput.value.trim(); if(!txt) return;
  cbAddMsg(txt, 'user');
  cbInput.value = ''; cbInput.disabled = true;
  // Intercept guided flows before AI
  if(_cbFlow === 'know_me'){
    cbInput.disabled = false; cbInput.focus();
    cbHandleKnowMe(txt);
    return;
  }
  _cbHistory.push({ role:'user', content: txt });
  cbShowTyping();
  try {
    const r = await fetch('/api/portal/chat', {
      method: 'POST', headers: {'Content-Type':'application/json'},
      body: JSON.stringify({ message: txt, email: _cbEmail, name: _cbName, history: _cbHistory.slice(-8) })
    });
    const d = await r.json();
    cbHideTyping();
    if(d.success){
      const reply = d.reply || 'Lo siento, no entendí. ¿Puedes reformular?';
      const html = reply.replace(/\*\*(.*?)\*\*/g,'<strong>$1</strong>').replace(/\n/g,'<br>');
      // If there's an action, append a button to the same message bubble
      let actionBtn = '';
      if(d.action && _CB_ACTION_LABELS[d.action]){
        const lbl = _CB_ACTION_LABELS[d.action].label;
        actionBtn = `<div style="margin-top:10px;"><button onclick="cbDoAction('${d.action}')" style="background:linear-gradient(135deg,#1e3a5f,#2563eb);color:#fff;border:none;border-radius:18px;padding:8px 16px;font-size:12px;font-weight:700;cursor:pointer;display:inline-flex;align-items:center;gap:6px;"><i class="bi bi-box-arrow-up-right"></i> ${lbl}</button></div>`;
      }
      cbAddMsg(html + actionBtn, 'bot');
      _cbHistory.push({ role:'assistant', content: reply });
    } else {
      cbAddMsg('⚠️ Hubo un error al procesar tu consulta. Intenta de nuevo.', 'bot');
    }
  } catch(e){
    cbHideTyping();
    cbAddMsg('⚠️ Sin conexión. Verifica tu red e intenta de nuevo.', 'bot');
  } finally { cbInput.disabled = false; cbInput.focus(); }
}

document.getElementById('cbSend').addEventListener('click', cbSendMsg);
cbInput.addEventListener('keypress', e => { if(e.key === 'Enter' && !cbInput.disabled) cbSendMsg(); });

