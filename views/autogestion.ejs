function setStar(section, n, btn){
  var cfg = _starSectionMap[section]; if(!cfg) return;
  cfg.store(n);
  document.querySelectorAll('#'+cfg.rowId+' .star-btn').forEach(function(b,i){
    b.classList.toggle('active', i < n);
    b.style.color = i < n ? '#f59e0b' : '#d1d5db';
  });
  btn.classList.remove('pop'); void btn.offsetWidth; btn.classList.add('pop');
  btn.addEventListener('animationend', function(){ btn.classList.remove('pop'); }, {once:true});
  burstStars(btn, n);
  var lbl = document.getElementById(cfg.labelId);
  if(lbl) lbl.textContent = _starLabels[n] || '';
}

function burstStars(el, count){
  const rect = el.getBoundingClientRect();
  const cx = rect.left + rect.width/2;
  const cy = rect.top  + rect.height/2;
  const particles = ['⭐','✨','💫','🌟','⚡'];
  const num = Math.min(4 + count, 10);
  for(let i = 0; i < num; i++){
    const p = document.createElement('span');
    p.className = 'star-particle';
    p.textContent = particles[i % particles.length];
    const angle = (360 / num) * i * (Math.PI / 180);
    const dist  = 40 + Math.random() * 50;
    p.style.setProperty('--tx', Math.cos(angle)*dist + 'px');
    p.style.setProperty('--ty', Math.sin(angle)*dist + 'px');
    p.style.left = cx + 'px';
    p.style.top  = cy + 'px';
    p.style.marginLeft = '-10px';
    p.style.marginTop  = '-10px';
    document.body.appendChild(p);
    p.addEventListener('animationend', () => p.remove());
  }
}

async function submitSurvey(){
  if(!_surveyRating){ document.getElementById('surveyStarLabel').textContent='👆 Selecciona una calificación'; return; }
  const comment = document.getElementById('surveyComment').value.trim();
  const appName = document.getElementById('surveyAppName').value.trim();
  try {
    await fetch('/api/portal/survey-general', { method:'POST', credentials:'include',
      headers:{'Content-Type':'application/json'},
      body: JSON.stringify({
        rating:          _surveyRating,
        rating_equipment: _surveyRatingEquip || null,
        rating_app:       _surveyRatingApp   || null,
        app_name:         appName || null,
        comment,
        portalEmail: localStorage.getItem('portal_user_email') || '',
        portalName:  localStorage.getItem('portal_user_name')  || ''
      }) });
  } catch(e) {}
  const name = (localStorage.getItem('portal_user_name')||'').split(' ')[0] || 'usuario';
  const t = _starThanks[_surveyRating] || _starThanks[5];
  document.getElementById('surveySuccessEmoji').textContent  = t.emoji;
  document.getElementById('surveyThanksTitle').textContent   = `¡Hola, ${name}! ${t.title}`;
  document.getElementById('surveyThanksMsg').textContent     = t.msg;
  document.getElementById('surveyStarsDisplay').textContent  = '★'.repeat(_surveyRating) + '☆'.repeat(5-_surveyRating);
  document.getElementById('surveyForm').style.display    = 'none';
  document.getElementById('surveySuccess').style.display = 'block';
  const modal = document.querySelector('#surveyModalOverlay .portal-modal');
  if(modal){ const r=modal.getBoundingClientRect(); burstStars({getBoundingClientRect:()=>({left:r.left+r.width/2-15,top:r.top+80,width:30,height:30})}, 5); }
  setTimeout(() => closePModal('surveyModalOverlay'), 3000);
}

