];

function cbOptClick(key){
  // Mostrar como mensaje de usuario
  const labels = {
    net_account:     '🔑 Cuenta de red',
    net_unlock:      '🔓 Desbloquear cuenta',
    net_reset:       '🔄 Resetear contraseña',
