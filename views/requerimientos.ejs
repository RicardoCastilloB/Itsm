<!DOCTYPE html>
<html lang="es">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title><%= title %> - Equipment Management</title>
    <link href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.1/font/bootstrap-icons.css" rel="stylesheet">
    <link href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.0.0/css/all.min.css" rel="stylesheet">
    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.2/dist/css/bootstrap.min.css" rel="stylesheet">
    <link rel="stylesheet" href="../css/style.css">
    <script src="https://cdn.jsdelivr.net/npm/chart.js@4.4.0/dist/chart.umd.min.js"></script>
    <style>
:root,[data-theme="light"]{
    --bg-main:#f5f7fa;--bg-card:#ffffff;--bg-header:#fafbfc;--border-soft:#e2e8f0;--border-row:#f1f5f9;
    --text-main:#1e293b;--text-muted:#64748b;--primary:#6366f1;--success:#10b981;--warning:#f59e0b;
    --info:#06b6d4;--danger:#ef4444;--purple:#8b5cf6;--req-blue:#4338ca;--req-hover:#3730a3;
    --hover-row:#f8fafc;--input-bg:#ffffff;--pill-bg:#ffffff;--upload-bg:transparent;
    --ac-bg:#ffffff;--ac-hover:#f0f0ff;--ac-border:#f1f5f9;
    --step2-bg:#f0fdf4;--step2-border:#bbf7d0;--step2-color:#065f46;
}
[data-theme="dark"]{
    --bg-main:#0f172a;--bg-card:#1e293b;--bg-header:#162032;--border-soft:#2d3f55;--border-row:#2d3f55;
    --text-main:#e2e8f0;--text-muted:#94a3b8;--primary:#818cf8;--success:#34d399;--warning:#fbbf24;
    --info:#22d3ee;--danger:#f87171;--purple:#a78bfa;--req-blue:#6366f1;--req-hover:#4338ca;
    --hover-row:#243348;--input-bg:#162032;--pill-bg:#1e293b;--upload-bg:#162032;
    --ac-bg:#1e293b;--ac-hover:#243348;--ac-border:#2d3f55;
    --step2-bg:#0a2a1a;--step2-border:#166534;--step2-color:#34d399;
}
body{margin:0;background:var(--bg-main);font-family:-apple-system,BlinkMacSystemFont,"Segoe UI",Roboto,sans-serif;color:var(--text-main);overflow-x:hidden;transition:background .3s,color .3s;}
.dashboard-wrapper{width:100%;padding:16px;margin-top:60px;}
.dashboard-content{width:100%;max-width:1680px;margin:0 auto;}
.cards-6{display:grid;grid-template-columns:repeat(6,1fr);gap:12px;margin-bottom:20px;}
@media(max-width:1400px){.cards-6{grid-template-columns:repeat(3,1fr);}}
@media(max-width:992px){.cards-6{grid-template-columns:repeat(2,1fr);}}
@media(max-width:576px){.cards-6{grid-template-columns:1fr;}}
.kpi-card{background:var(--bg-card);border-radius:12px;height:100px;padding:16px;display:flex;justify-content:space-between;align-items:center;border:1px solid var(--border-soft);box-shadow:0 1px 3px rgba(0,0,0,.05);transition:all .2s;cursor:pointer;}
.kpi-card:hover{transform:translateY(-2px);box-shadow:0 4px 12px rgba(0,0,0,.08);}
.kpi-title{font-size:10px;letter-spacing:.5px;text-transform:uppercase;color:var(--text-muted);font-weight:600;margin-bottom:6px;}
.kpi-value{font-size:28px;font-weight:700;line-height:1;}
.kpi-icon{font-size:32px;opacity:.25;}
.primary{color:var(--primary);}.success{color:var(--success);}.warning{color:var(--warning);}.info{color:var(--info);}.danger{color:var(--danger);}.purple{color:var(--purple);}
.page-header{display:flex;align-items:center;justify-content:space-between;margin-bottom:20px;flex-wrap:wrap;gap:12px;}
.page-title{font-size:22px;font-weight:700;color:var(--text-main);display:flex;align-items:center;gap:10px;}
.page-title .req-badge{background:var(--req-blue);color:white;font-size:10px;font-weight:700;padding:2px 8px;border-radius:20px;letter-spacing:.5px;}
.card-panel{background:var(--bg-card);border-radius:12px;border:1px solid var(--border-soft);box-shadow:0 1px 3px rgba(0,0,0,.05);padding:20px;margin-bottom:20px;transition:background .3s,border-color .3s;}
.card-panel-title{font-size:13px;font-weight:700;text-transform:uppercase;letter-spacing:.5px;color:var(--text-muted);margin-bottom:16px;display:flex;align-items:center;gap:8px;}
/* Status badges */
.ist-badge{display:inline-flex;align-items:center;gap:4px;font-size:10px;font-weight:600;padding:3px 8px;border-radius:20px;}
.ist-abierto{background:#dbeafe;color:#1d4ed8;}.ist-asignado{background:#ede9fe;color:#7c3aed;}
.ist-en_progreso{background:#fef3c7;color:#d97706;}.ist-pendiente_usuario{background:#fee2e2;color:#dc2626;}
.ist-resuelto{background:#d1fae5;color:#065f46;}.ist-cerrado{background:#f1f5f9;color:#64748b;}
[data-theme="dark"] .ist-abierto{background:#1e3a5f;color:#93c5fd;}[data-theme="dark"] .ist-asignado{background:#3b1d5f;color:#c4b5fd;}
[data-theme="dark"] .ist-en_progreso{background:#422006;color:#fde68a;}[data-theme="dark"] .ist-pendiente_usuario{background:#450a0a;color:#fca5a5;}
[data-theme="dark"] .ist-resuelto{background:#064e3b;color:#6ee7b7;}[data-theme="dark"] .ist-cerrado{background:#1e293b;color:#94a3b8;}
/* Priority badges */
.prio-badge{display:inline-flex;align-items:center;font-size:10px;font-weight:700;padding:2px 7px;border-radius:4px;letter-spacing:.3px;}
.prio-P1{background:#fee2e2;color:#dc2626;}.prio-P2{background:#fef3c7;color:#d97706;}
.prio-P3{background:#e0e7ff;color:#4338ca;}.prio-P4{background:#f1f5f9;color:#64748b;}
[data-theme="dark"] .prio-P1{background:#450a0a;color:#f87171;}[data-theme="dark"] .prio-P2{background:#451a03;color:#fbbf24;}
[data-theme="dark"] .prio-P3{background:#1e1b4b;color:#a5b4fc;}[data-theme="dark"] .prio-P4{background:#1e293b;color:#94a3b8;}
/* Table */
.table-req thead th{font-size:11px;text-transform:uppercase;letter-spacing:.4px;color:var(--text-muted);font-weight:600;border-bottom:2px solid var(--border-soft);padding:10px 12px;white-space:nowrap;background:var(--bg-header);}
.table-req td{padding:10px 12px;vertical-align:middle;font-size:13px;border-bottom:1px solid var(--border-row);color:var(--text-main);}
.table-req tbody tr:hover{background:var(--hover-row);}
[data-theme="dark"] .table-req{--bs-table-bg:transparent;}
.req-key{font-family:monospace;font-weight:700;color:var(--req-blue);font-size:12px;}
.req-key a{color:inherit;text-decoration:none;}.req-key a:hover{text-decoration:underline;}
/* Tipo badge */
.tipo-badge{font-size:10px;font-weight:600;padding:2px 8px;border-radius:12px;background:rgba(99,102,241,.1);color:var(--req-blue);border:1px solid rgba(99,102,241,.25);}
[data-theme="dark"] .tipo-badge{background:rgba(129,140,248,.15);color:#a5b4fc;}
/* Buttons */
.btn-take{background:var(--req-blue);color:#fff;border:none;border-radius:6px;padding:4px 10px;font-size:11px;font-weight:600;cursor:pointer;transition:background .15s;}
.btn-take:hover{background:var(--req-hover);}
.btn-manage{background:transparent;color:var(--req-blue);border:1.5px solid var(--req-blue);border-radius:6px;padding:4px 10px;font-size:11px;font-weight:600;cursor:pointer;transition:all .15s;}
.btn-manage:hover{background:var(--req-blue);color:#fff;}
.btn-create{background:var(--req-blue);color:white;border:none;border-radius:8px;padding:10px 24px;font-size:13px;font-weight:600;cursor:pointer;display:flex;align-items:center;gap:8px;transition:all .2s;}
.btn-create:hover{background:var(--req-hover);transform:translateY(-1px);}
.btn-create:disabled{opacity:.6;cursor:not-allowed;transform:none;}
.btn-outline-sm{border:1.5px solid var(--border-soft);background:transparent;border-radius:6px;padding:4px 10px;font-size:11px;font-weight:600;cursor:pointer;transition:all .15s;color:var(--text-muted);display:inline-flex;align-items:center;gap:4px;}
.btn-outline-sm:hover{border-color:var(--req-blue);color:var(--req-blue);background:var(--hover-row);}
.btn-close-req{border-color:#fca5a5;color:#dc2626;}
.btn-close-req:hover{background:#fee2e2;border-color:#dc2626;}
/* Form */
.form-label-custom{font-size:11px;font-weight:600;text-transform:uppercase;letter-spacing:.4px;color:var(--text-muted);margin-bottom:6px;}
.form-control-custom,.form-select-custom{border:1.5px solid var(--border-soft);border-radius:8px;padding:9px 12px;font-size:13px;transition:border-color .2s,background .3s;width:100%;background:var(--input-bg);color:var(--text-main);}
.form-control-custom:focus,.form-select-custom:focus{outline:none;border-color:var(--primary);box-shadow:0 0 0 3px rgba(99,102,241,.1);}
.form-control-custom::placeholder{color:var(--text-muted);}
textarea.form-control-custom{resize:vertical;}
/* Search & filters */
.search-bar{display:flex;gap:10px;align-items:center;margin-bottom:16px;flex-wrap:wrap;}
.search-input-wrap{position:relative;flex:1;min-width:200px;}
.search-input-wrap i{position:absolute;left:11px;top:50%;transform:translateY(-50%);color:var(--text-muted);font-size:14px;}
.search-input-wrap input{padding-left:34px;border:1.5px solid var(--border-soft);border-radius:8px;padding-top:8px;padding-bottom:8px;font-size:13px;width:100%;background:var(--input-bg);color:var(--text-main);}
.search-input-wrap input:focus{outline:none;border-color:var(--primary);box-shadow:0 0 0 3px rgba(99,102,241,.1);}
.filter-pills{display:flex;gap:6px;flex-wrap:wrap;}
.pill{border:1.5px solid var(--border-soft);background:var(--pill-bg);border-radius:20px;padding:4px 14px;font-size:12px;font-weight:600;cursor:pointer;transition:all .15s;color:var(--text-muted);}
.pill.active{background:var(--req-blue);border-color:var(--req-blue);color:white;}
.pill:hover:not(.active){border-color:var(--req-blue);color:var(--req-blue);}
/* Autocomplete */
.autocomplete-wrap{position:relative;}
.ac-dropdown{position:absolute;top:calc(100% + 4px);left:0;right:0;background:var(--ac-bg);border:1.5px solid var(--border-soft);border-radius:10px;box-shadow:0 10px 36px rgba(0,0,0,.12);max-height:280px;overflow-y:auto;z-index:1060;display:none;}
.ac-dropdown.show{display:block;animation:dropIn .15s ease;}
@keyframes dropIn{from{opacity:0;transform:translateY(-5px);}to{opacity:1;transform:translateY(0);}}
.ac-item{padding:10px 14px;cursor:pointer;border-bottom:1px solid var(--ac-border);transition:background .12s;}
.ac-item:last-child{border-bottom:none;}
.ac-item:hover,.ac-item.active-ac{background:var(--ac-hover);}
.ac-email{font-weight:600;font-size:13px;color:var(--text-main);display:block;margin-bottom:2px;}
.ac-details{font-size:11px;color:var(--text-muted);}
/* Upload */
.upload-zone{border:2px dashed var(--border-soft);border-radius:8px;padding:20px;text-align:center;cursor:pointer;transition:all .2s;color:var(--text-muted);font-size:13px;position:relative;background:var(--upload-bg);}
.upload-zone:hover,.upload-zone.dragover{border-color:var(--primary);color:var(--primary);background:var(--hover-row);}
.upload-zone input[type="file"]{position:absolute;inset:0;opacity:0;cursor:pointer;}
.upload-preview{display:flex;align-items:center;gap:8px;margin-top:8px;font-size:12px;color:var(--success);}
/* Modal */
.modal-header-req{background:linear-gradient(135deg,#4338ca,#6366f1);color:white;border-radius:12px 12px 0 0;padding:16px 20px;}
.modal-content{border-radius:12px;border:none;box-shadow:0 20px 60px rgba(0,0,0,.15);}
[data-theme="dark"] .modal-content{background:var(--bg-card)!important;color:var(--text-main)!important;}
[data-theme="dark"] .modal-body{background:var(--bg-card)!important;}
[data-theme="dark"] .modal-footer{background:var(--bg-header)!important;border-color:var(--border-soft)!important;}
[data-theme="dark"] .btn-close{filter:invert(1);}
/* Toast */
.toast-container-custom{position:fixed;bottom:24px;right:24px;z-index:9999;display:flex;flex-direction:column;gap:8px;}
.toast-msg{background:var(--text-main);color:white;padding:12px 18px;border-radius:10px;font-size:13px;font-weight:500;display:flex;align-items:center;gap:10px;box-shadow:0 4px 20px rgba(0,0,0,.2);animation:slideUp .3s ease;min-width:280px;}
.toast-msg.success{background:#065f46;}.toast-msg.error{background:#991b1b;}
@keyframes slideUp{from{transform:translateY(20px);opacity:0;}to{transform:translateY(0);opacity:1;}}
/* Corp tabs */
.corp-tabnav{display:flex;gap:0;border-bottom:2px solid var(--border-soft);margin-bottom:24px;background:var(--bg-card);border-radius:12px 12px 0 0;padding:0 8px;box-shadow:0 1px 3px rgba(0,0,0,.04);}
.corp-tab{background:none;border:none;border-bottom:3px solid transparent;padding:14px 20px;font-size:13px;font-weight:600;color:var(--text-muted);cursor:pointer;display:inline-flex;align-items:center;gap:8px;transition:all .2s;margin-bottom:-2px;white-space:nowrap;}
.corp-tab:hover{color:var(--req-blue);}
.corp-tab.active{color:var(--req-blue);border-bottom-color:var(--req-blue);}
.corp-tab i{font-size:14px;}
.corp-tabpanel{animation:fadeIn .2s ease;}
@keyframes fadeIn{from{opacity:0;transform:translateY(4px);}to{opacity:1;transform:translateY(0);}}
/* Empty + spinner */
.empty-state{text-align:center;padding:48px 20px;color:var(--text-muted);}
.empty-state i{font-size:48px;opacity:.3;margin-bottom:12px;display:block;}
.spinner-wrap{display:flex;align-items:center;justify-content:center;padding:40px;color:var(--text-muted);gap:10px;font-size:13px;}
/* Theme toggle */
.theme-toggle-wrap{display:flex;align-items:center;gap:7px;cursor:pointer;user-select:none;padding:4px 10px 4px 8px;border-radius:20px;transition:background .2s;}
.theme-toggle-wrap:hover{background:rgba(0,0,0,.06);}
.theme-switch{width:34px;height:18px;background:#cbd5e1;border-radius:9px;position:relative;transition:background .3s;flex-shrink:0;}
[data-theme="dark"] .theme-switch{background:#6366f1;}
.theme-switch-knob{width:13px;height:13px;background:#fff;border-radius:50%;position:absolute;top:2.5px;left:3px;box-shadow:0 1px 3px rgba(0,0,0,.25);transition:transform .3s;}
[data-theme="dark"] .theme-switch-knob{transform:translateX(16px);}
.theme-toggle-label{font-size:12px;font-weight:600;color:#64748b;transition:color .3s;}
[data-theme="dark"] .theme-toggle-label{color:#94a3b8;}
    </style>
</head>
<body>

<div class="sidebar-overlay" id="sidebarOverlay"></div>
<div class="sidebar" id="sidebar">
    <div class="sidebar-header"><button class="close-sidebar" id="closeSidebar"><i class="fas fa-times"></i></button></div>
    <div class="menu-item"><a href="<%= APP_URL %>/home" class="menu-header"><div class="menu-title"><i class="fas fa-home"></i><span>Home</span></div></a></div>
    <div class="menu-item"><a href="<%= APP_URL %>/tickets" class="menu-header"><div class="menu-title"><i class="fas fa-ticket-alt"></i><span>Incidencias</span></div></a></div>
    <div class="menu-item"><a href="<%= APP_URL %>/requerimientos" class="menu-header"><div class="menu-title"><i class="fas fa-clipboard-list"></i><span>Requerimientos</span></div></a></div>
    <div class="menu-item"><a href="<%= APP_URL %>/logout" class="menu-header"><div class="menu-title"><i class="fas fa-sign-out-alt"></i><span>Cerrar Sesión</span></div></a></div>
</div>

<nav class="navbar navbar-expand-lg fixed-top" id="navbar">
    <div class="container-fluid">
        <button class="toggler-btn" id="mainToggleSidebar"><i class="fas fa-bars"></i></button>
        <div class="theme-toggle-wrap ms-auto" onclick="toggleTheme()" role="button">
            <i class="theme-toggle-icon" id="toggleIcon">🌙</i>
            <div class="theme-switch"><div class="theme-switch-knob" id="switchKnob"></div></div>
            <span class="theme-toggle-label" id="toggleLabel">Oscuro</span>
        </div>
    </div>
</nav>
<script>
(function(){document.documentElement.setAttribute('data-theme',localStorage.getItem('dashboardTheme')||'light');})();
function toggleTheme(){const h=document.documentElement,c=h.getAttribute('data-theme'),n=c==='dark'?'light':'dark';h.setAttribute('data-theme',n);localStorage.setItem('dashboardTheme',n);_syncUI(n);}
function _syncUI(t){const i=document.getElementById('toggleIcon'),l=document.getElementById('toggleLabel');if(!i||!l)return;i.textContent=t==='dark'?'☀️':'🌙';l.textContent=t==='dark'?'Claro':'Oscuro';}
document.addEventListener('DOMContentLoaded',()=>_syncUI(localStorage.getItem('dashboardTheme')||'light'));
</script>

<div class="dashboard-wrapper">
<div class="dashboard-content">

<%
  const _role = user?.role || 'usuario';
  const _isAdmin        = _role === 'administrador';
  const _isEspecialista = ['especialista','agente','tecnico'].includes(_role);
  const _isVisor        = _role === 'visor';
  const _currentUserId  = user?.id || null;
%>

<nav class="corp-tabnav" role="tablist">
  <button class="corp-tab active" id="tabBtnCreate"  onclick="doTab('create',this)"><i class="bi bi-pencil-square"></i> Registrar</button>
  <% if (_isAdmin || _isEspecialista) { %>
  <button class="corp-tab" id="tabBtnGestion" onclick="doTab('gestion',this)"><i class="bi bi-clipboard-check"></i> Gestión</button>
  <% } %>
  <% if (_isAdmin || _isEspecialista || _isVisor) { %>
  <button class="corp-tab" id="tabBtnKpis"   onclick="doTab('kpis',this)"><i class="bi bi-bar-chart-line"></i> Indicadores</button>
  <% } %>
  <% if (_isAdmin) { %>
  <button class="corp-tab" id="tabBtnAdmin"  onclick="doTab('admin',this)"><i class="bi bi-shield-lock"></i> Administración</button>
  <% } %>
</nav>
<script>
var _tabLoaded = {};
function doTab(name, btn) {
    var panels = {create:'tabCreate', gestion:'tabGestion', kpis:'tabKpis', admin:'tabAdmin'};
    Object.values(panels).forEach(function(id){ var el=document.getElementById(id); if(el) el.style.display='none'; });
    document.querySelectorAll('.corp-tab').forEach(function(b){ b.classList.remove('active'); });
    var target = document.getElementById(panels[name]);
    if (target) target.style.display = 'block';
    if (btn) btn.classList.add('active');
    if (!_tabLoaded[name]) {
        _tabLoaded[name] = true;
        setTimeout(function(){
            if (name==='gestion' && typeof loadReqs==='function') loadReqs();
            if (name==='kpis'    && typeof loadReqStats==='function') loadReqStats();
            if (name==='admin'   && typeof loadAdminUsers==='function') loadAdminUsers();
        }, 0);
    }
}
</script>

<!-- ══ TAB 1: REGISTRAR ══ -->
<div id="tabCreate" class="corp-tabpanel">
  <div style="max-width:680px;margin:0 auto;">
    <div class="card-panel">
      <div style="text-align:center;margin-bottom:24px;padding-bottom:20px;border-bottom:1px solid var(--border-soft);">
        <div style="width:60px;height:60px;background:linear-gradient(135deg,#4338ca,#6366f1);border-radius:14px;display:flex;align-items:center;justify-content:center;margin:0 auto 12px;">
          <i class="bi bi-clipboard2-plus-fill" style="font-size:26px;color:#fff;"></i>
        </div>
        <div style="font-size:18px;font-weight:700;color:var(--text-main);">Registrar Requerimiento</div>
        <div style="font-size:12px;color:var(--text-muted);margin-top:4px;">Portal de Servicios TI · Jira Service Management</div>
      </div>

      <div style="display:flex;flex-direction:column;gap:18px;">
        <!-- Reporter -->
        <div>
          <div class="form-label-custom">Tu correo corporativo *</div>
          <div class="autocomplete-wrap">
            <input type="email" id="rq_reporter" class="form-control-custom" placeholder="usuario@integratel.com.pe"
                   autocomplete="off" oninput="acRqReporter(this.value)" onkeydown="acKeydownRq(event,'acRqReporterDrop')"
                   onblur="loadRqEmployeeInfo(this.value.trim())">
            <div id="acRqReporterDrop" class="ac-dropdown"></div>
          </div>
        </div>

        <!-- Employee info -->
        <div id="rqEmployeeInfo" style="display:none;background:var(--step2-bg);border:1.5px solid var(--step2-border);border-radius:10px;padding:14px 16px;">
          <div style="font-size:11px;font-weight:700;text-transform:uppercase;letter-spacing:.5px;color:var(--step2-color);margin-bottom:10px;display:flex;align-items:center;gap:6px;"><i class="bi bi-person-badge"></i> Información del colaborador</div>
          <div style="display:grid;grid-template-columns:1fr 1fr;gap:8px 16px;">
            <div><div style="font-size:10px;font-weight:600;color:var(--text-muted);text-transform:uppercase;letter-spacing:.4px;margin-bottom:2px;">Nombre</div><div id="rqEqNombre" style="font-size:13px;font-weight:600;color:var(--text-main);">—</div></div>
            <div><div style="font-size:10px;font-weight:600;color:var(--text-muted);text-transform:uppercase;letter-spacing:.4px;margin-bottom:2px;">Departamento</div><div id="rqEqDept" style="font-size:13px;font-weight:600;color:var(--text-main);">—</div></div>
            <div><div style="font-size:10px;font-weight:600;color:var(--text-muted);text-transform:uppercase;letter-spacing:.4px;margin-bottom:2px;">Equipo / Tag</div><div id="rqEqEquipo" style="font-size:13px;font-weight:600;color:var(--text-main);">—</div></div>
            <div><div style="font-size:10px;font-weight:600;color:var(--text-muted);text-transform:uppercase;letter-spacing:.4px;margin-bottom:2px;">Ubicación</div><div id="rqEqUbicacion" style="font-size:13px;font-weight:600;color:var(--text-main);">—</div></div>
          </div>
        </div>

        <!-- Tipo de requerimiento -->
        <div>
          <div class="form-label-custom">Tipo de Requerimiento *</div>
          <select id="rq_tipo" class="form-select-custom" onchange="rqTipoChange()">
            <option value="">— Selecciona el tipo —</option>
            <option value="Hardware">💻 Hardware (equipo, periférico, accesorio)</option>
