<!-- Toast container -->
<div class="toast-container-custom" id="toastContainer"></div>

<script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.2/dist/js/bootstrap.bundle.min.js"></script>
<script src="/js/sidebar.js"></script>
<script>
// ── GLOBALS ────────────────────────────────────────────────────────────────
var _allReqs = [], _rqPill = 'all', _rqPage = 1;
const RQ_PAGE_SIZE = 20;
const CURRENT_USER_ID = <%- JSON.stringify(_currentUserId) %>;
var _mgReqKey = null;
var _rqAttachmentId = null;
var _acRqTimer = null;

// ── TOAST ──────────────────────────────────────────────────────────────────
function showToast(msg, type='') {
    const c = document.getElementById('toastContainer');
    const d = document.createElement('div');
    d.className = 'toast-msg' + (type ? ' '+type : '');
    d.innerHTML = `<i class="bi bi-${type==='success'?'check-circle-fill':type==='error'?'x-circle-fill':'info-circle-fill'}"></i> ${msg}`;
    c.appendChild(d);
    setTimeout(() => d.remove(), 4000);
}

// ── AUTOCOMPLETE REPORTER ──────────────────────────────────────────────────
function acRqReporter(val) {
    clearTimeout(_acRqTimer);
    _acRqTimer = setTimeout(() => _acRqFetch(val), 300);
}
async function _acRqFetch(val) {
    const drop = document.getElementById('acRqReporterDrop');
    if (!val || val.length < 2) { drop.classList.remove('show'); return; }
    try {
        const r = await fetch(`/api/employees/search-emails?q=${encodeURIComponent(val)}`, {credentials:'include'});
        const d = await r.json();
        const items = d.data || [];
        if (!items.length) { drop.classList.remove('show'); return; }
        drop.innerHTML = items.slice(0,8).map((it,i) => `
            <div class="ac-item" data-email="${it.email}" data-name="${it.full_name||''}"
                 onmousedown="acRqPickReporter('${it.email}','${it.full_name||''}')">
                <span class="ac-email">${it.email}</span>
                <span class="ac-details">${it.full_name||''}${it.position_name?' · '+it.position_name:''}</span>
            </div>`).join('');
        drop.classList.add('show');
    } catch(e) { drop.classList.remove('show'); }
}
function acRqPickReporter(email, name) {
    document.getElementById('rq_reporter').value = email;
    document.getElementById('acRqReporterDrop').classList.remove('show');
    loadRqEmployeeInfo(email);
}
function acKeydownRq(e, dropId) {
    const drop = document.getElementById(dropId);
    const items = drop.querySelectorAll('.ac-item');
    let cur = drop.querySelector('.active-ac');
    if (e.key === 'ArrowDown') { e.preventDefault(); let nx = cur ? cur.nextElementSibling : items[0]; if(nx){cur?.classList.remove('active-ac'); nx.classList.add('active-ac');} }
    else if (e.key === 'ArrowUp') { e.preventDefault(); let pv = cur?.previousElementSibling; if(pv){cur.classList.remove('active-ac'); pv.classList.add('active-ac');} }
    else if (e.key === 'Enter') { e.preventDefault(); if(cur) cur.dispatchEvent(new MouseEvent('mousedown')); }
    else if (e.key === 'Escape') { drop.classList.remove('show'); }
}
document.addEventListener('click', e => {
    if (!e.target.closest('#acRqReporterDrop') && !e.target.closest('#rq_reporter'))
        document.getElementById('acRqReporterDrop')?.classList.remove('show');
});

async function loadRqEmployeeInfo(email) {
    if (!email || !email.includes('@')) return;
    try {
        const r = await fetch(`/api/jira/employee-info?email=${encodeURIComponent(email)}`, {credentials:'include'});
        const d = await r.json();
        if (d.success && d.data) {
            const info = document.getElementById('rqEmployeeInfo');
            document.getElementById('rqEqNombre').textContent    = d.data.full_name  || '—';
            document.getElementById('rqEqDept').textContent      = d.data.department || '—';
            document.getElementById('rqEqEquipo').textContent    = d.data.equipo     || '—';
            document.getElementById('rqEqUbicacion').textContent = d.data.ubicacion  || '—';
            info.style.display = 'block';
        }
    } catch(e) {}
}

// ── TIPO CHANGE → autofill description ────────────────────────────────────
const _tipoDesc = {
    'Hardware':              'Solicito {summary}. Por favor coordinar entrega/instalación del hardware requerido.',
    'Software':              'Solicito {summary}. Requiero instalación/activación del software indicado en mi equipo.',
    'Accesos y Permisos':    'Solicito {summary}. Por favor gestionar el acceso/permiso indicado según las políticas de TI.',
    'Servicios de Red':      'Solicito {summary}. Requiero soporte en la configuración/acceso a los servicios de red indicados.',
    'Telefonía':             'Solicito {summary}. Por favor gestionar lo indicado relacionado a telefonía.',
    'Correo Corporativo':    'Solicito {summary}. Por favor realizar la configuración o gestión de correo corporativo indicada.',
    'Soporte en Sitio':      'Solicito visita técnica presencial. Detalle: {summary}. Confirmar disponibilidad y fecha.',
    'Otros':                 'Solicito {summary}. Adjunto información adicional si es necesaria.',
};
function rqTipoChange() {
    rqAutoDesc();
}
function rqAutoDesc() {
    const tipo    = document.getElementById('rq_tipo').value;
    const summary = document.getElementById('rq_summary').value.trim();
    const descEl  = document.getElementById('rq_description');
    if (!tipo) return;
    const tpl = _tipoDesc[tipo] || 'Solicito {summary}.';
    descEl.value = tpl.replace('{summary}', summary || '[describe tu requerimiento]');
}

// ── FILE UPLOAD ────────────────────────────────────────────────────────────
async function rqHandleFile(input) {
    const file = input.files[0];
    if (!file) return;
    if (file.size > 10 * 1024 * 1024) { showToast('Archivo demasiado grande (máx 10MB)', 'error'); input.value=''; return; }
    const fd = new FormData();
    fd.append('file', file);
    try {
        const r = await fetch('/api/jira/attachment', { method:'POST', body:fd, credentials:'include' });
        const d = await r.json();
        if (d.success) {
            _rqAttachmentId = d.attachmentId;
            document.getElementById('rqUploadFileName').textContent = file.name;
            document.getElementById('rqUploadPreview').style.display = 'flex';
            document.getElementById('rqUploadZone').style.opacity = '.5';
        } else { showToast('Error subiendo adjunto: '+d.message, 'error'); }
    } catch(e) { showToast('Error de conexión al subir adjunto', 'error'); }
}
function rqClearFile() {
    _rqAttachmentId = null;
    document.getElementById('rq_attachment').value = '';
    document.getElementById('rqUploadPreview').style.display = 'none';
    document.getElementById('rqUploadZone').style.opacity = '1';
}

// ── SUBMIT ─────────────────────────────────────────────────────────────────
async function submitReq() {
    const reporter    = document.getElementById('rq_reporter').value.trim();
    const tipo        = document.getElementById('rq_tipo').value;
    const summary     = document.getElementById('rq_summary').value.trim();
    const description = document.getElementById('rq_description').value.trim();
    const priority    = document.getElementById('rq_priority').value;
    const phone       = document.getElementById('rq_phone').value.trim() || '-';

    if (!reporter)    { showToast('Ingresa tu correo corporativo', 'error'); return; }
    if (!tipo)        { showToast('Selecciona el tipo de requerimiento', 'error'); return; }
    if (!summary)     { showToast('Describe qué necesitas', 'error'); return; }
    if (!description) { showToast('Agrega una descripción detallada', 'error'); return; }

    const btn = document.getElementById('rqBtnSubmit');
    btn.disabled = true;
    btn.innerHTML = '<span class="spinner-border spinner-border-sm"></span> Registrando...';

    try {
        const r = await fetch('/api/jira/requirement', {
            method: 'POST', credentials: 'include',
            headers: {'Content-Type':'application/json'},
            body: JSON.stringify({ reporter, tipo, summary, description, priority, phone, attachmentId: _rqAttachmentId })
        });
        const d = await r.json();
        if (d.success) {
            document.getElementById('rqCreatedKey').textContent = d.data.key;
            document.getElementById('rqCreatedUrl').href = d.data.url;
            document.getElementById('rqResult').style.display = 'block';
            showToast(`✅ Requerimiento ${d.data.key} registrado`, 'success');
            // Métrica: requerimiento efectivamente registrado
            const _rqEmail = document.getElementById('rq_reporter')?.value?.trim() || localStorage.getItem('portal_user_email') || '';
            if(_rqEmail) fetch('/api/portal/activity-log',{method:'POST',credentials:'include',headers:{'Content-Type':'application/json'},
                body:JSON.stringify({email:_rqEmail,action:'requerimiento_creado',page:'requerimientos',metadata:{key:d.data?.key||''}})}).catch(()=>{});
        } else {
            showToast('Error: ' + (d.message || 'No se pudo crear el requerimiento'), 'error');
        }
    } catch(e) {
        showToast('Error de conexión', 'error');
    } finally {
        btn.disabled = false;
        btn.innerHTML = '<i class="bi bi-send-fill"></i> Registrar Requerimiento';
    }
}

function resetRqForm() {
    ['rq_reporter','rq_tipo','rq_summary','rq_description','rq_phone'].forEach(id => {
        const el = document.getElementById(id);
        if (el) el.value = id === 'rq_phone' ? '-' : id === 'rq_priority' ? 'P3' : '';
    });
    document.getElementById('rqResult').style.display = 'none';
    document.getElementById('rqEmployeeInfo').style.display = 'none';
    rqClearFile();
}

// ── GESTIÓN — LOAD & RENDER ────────────────────────────────────────────────
async function loadReqs() {
    const wrap = document.getElementById('rqTableWrap');
    wrap.innerHTML = '<div class="spinner-wrap"><div class="spinner-border spinner-border-sm text-primary"></div> Cargando...</div>';
    try {
        const r = await fetch('/api/jira/requirements', {credentials:'include'});
        const d = await r.json();
        _allReqs = d.data || [];
        updateRqKpis();
        renderReqs();
    } catch(e) {
        wrap.innerHTML = '<div class="empty-state"><i class="bi bi-exclamation-triangle"></i><p>Error cargando requerimientos</p></div>';
    }
}

function updateRqKpis() {
    const now = new Date();
    const thisMonth = now.getMonth() + '-' + now.getFullYear();
    document.getElementById('rqKpiTotal').textContent    = _allReqs.length;
    document.getElementById('rqKpiOpen').textContent     = _allReqs.filter(r => r.internal_status === 'abierto').length;
    document.getElementById('rqKpiProgress').textContent = _allReqs.filter(r => ['asignado','en_progreso','pendiente_usuario'].includes(r.internal_status)).length;
    document.getElementById('rqKpiClosed').textContent   = _allReqs.filter(r => ['resuelto','cerrado'].includes(r.internal_status)).length;
    document.getElementById('rqKpiCritical').textContent = _allReqs.filter(r => ['P1','P2'].includes(r.priority)).length;
    document.getElementById('rqKpiMonth').textContent    = _allReqs.filter(r => {
        if (!r.created) return false;
        const d = new Date(r.created);
        return (d.getMonth() + '-' + d.getFullYear()) === thisMonth;
    }).length;
}

function setRqPill(el, val) {
    document.querySelectorAll('.pill').forEach(p => p.classList.remove('active'));
    el.classList.add('active');
    _rqPill = val;
    _rqPage = 1;
    renderReqs();
}

function filterReqs() { _rqPage = 1; renderReqs(); }

function renderReqs() {
    const q = (document.getElementById('rqSearchInput')?.value || '').toLowerCase();
    let list = _allReqs.filter(r => {
        if (_rqPill === 'unassigned') return !r.assigned_to && !['resuelto','cerrado'].includes(r.internal_status);
        if (_rqPill === 'mine')       return r.assigned_to === CURRENT_USER_ID;
        if (_rqPill === 'progress')   return ['asignado','en_progreso','pendiente_usuario'].includes(r.internal_status);
        if (_rqPill === 'closed')     return ['resuelto','cerrado'].includes(r.internal_status);
        if (_rqPill === 'p1p2')       return ['P1','P2'].includes(r.priority);
        return true;
    });
    if (q) list = list.filter(r => [r.key,r.summary,r.tipo,r.reporter,r.assigned_to_name].join(' ').toLowerCase().includes(q));

    const total = list.length, pages = Math.max(1, Math.ceil(total / RQ_PAGE_SIZE));
    if (_rqPage > pages) _rqPage = pages;
    const slice = list.slice((_rqPage-1)*RQ_PAGE_SIZE, _rqPage*RQ_PAGE_SIZE);

    const wrap = document.getElementById('rqTableWrap');
    if (!slice.length) {
        wrap.innerHTML = '<div class="empty-state"><i class="bi bi-inbox"></i><p>Sin requerimientos</p></div>';
        document.getElementById('rqPaginationInfo').textContent = '';
        document.getElementById('rqPaginationBtns').innerHTML = '';
        return;
    }

    const prioBadge = p => `<span class="prio-badge prio-${p}">${p}</span>`;
    const istBadge  = s => {
        const labels = {abierto:'Abierto',asignado:'Asignado',en_progreso:'En progreso',pendiente_usuario:'Pend. usuario',resuelto:'Resuelto',cerrado:'Cerrado'};
        return `<span class="ist-badge ist-${s||'abierto'}">${labels[s]||s}</span>`;
    };
    const relTime = d => {
        if (!d) return '—';
        const diff = Date.now() - new Date(d).getTime();
        const h = Math.floor(diff/3600000), m = Math.floor(diff/60000);
        return h > 48 ? new Date(d).toLocaleDateString('es-PE') : h > 0 ? `hace ${h}h` : `hace ${m}m`;
    };

    wrap.innerHTML = `<div style="overflow-x:auto;"><table class="table table-req" style="width:100%;min-width:900px;">
<thead><tr>
  <th>Clave</th><th>Resumen</th><th>Tipo</th><th>Solicitante</th>
  <th>Prio.</th><th>Estado</th><th>Asignado a</th><th>Creado</th><th>Acciones</th>
</tr></thead><tbody>
${slice.map(r => `<tr>
  <td><span class="req-key"><a href="${r.url||'#'}" target="_blank">${r.key}</a></span></td>
  <td style="max-width:220px;white-space:nowrap;overflow:hidden;text-overflow:ellipsis;" title="${r.summary||''}">${r.summary||'—'}</td>
  <td>${r.tipo ? `<span class="tipo-badge">${r.tipo}</span>` : '—'}</td>
  <td style="font-size:12px;max-width:160px;white-space:nowrap;overflow:hidden;text-overflow:ellipsis;">${r.reporter||'—'}</td>
  <td>${prioBadge(r.priority||'P3')}</td>
  <td>${istBadge(r.internal_status)}</td>
  <td style="font-size:12px;">${r.assigned_to_name||'<span style="color:var(--text-muted)">Sin asignar</span>'}</td>
  <td style="font-size:11px;color:var(--text-muted);">${relTime(r.created)}</td>
  <td>
    <div style="display:flex;gap:5px;flex-wrap:nowrap;">
      ${!r.assigned_to ? `<button class="btn-take" onclick="takeReq('${r.key}')">Tomar</button>` : ''}
      <button class="btn-manage" onclick="openManageReq(${JSON.stringify(r).replace(/"/g,'&quot;')})">Gestionar</button>
    </div>
  </td>
</tr>`).join('')}
</tbody></table></div>`;

    document.getElementById('rqPaginationInfo').textContent = `Mostrando ${(_rqPage-1)*RQ_PAGE_SIZE+1}–${Math.min(_rqPage*RQ_PAGE_SIZE,total)} de ${total}`;
    const btns = document.getElementById('rqPaginationBtns');
    btns.innerHTML = '';
    if (pages > 1) {
        const mkBtn = (label, page, disabled, active) => {
            const b = document.createElement('button');
            b.className = 'btn-outline-sm' + (active ? ' active' : '');
            b.textContent = label;
            b.disabled = disabled;
            if (active) { b.style.background = 'var(--req-blue)'; b.style.color = '#fff'; b.style.borderColor = 'var(--req-blue)'; }
            b.onclick = () => { _rqPage = page; renderReqs(); };
            btns.appendChild(b);
        };
        mkBtn('‹', _rqPage-1, _rqPage===1, false);
        for (let i=1; i<=pages; i++) if (i===1||i===pages||Math.abs(i-_rqPage)<=1) mkBtn(i, i, false, i===_rqPage);
        mkBtn('›', _rqPage+1, _rqPage===pages, false);
    }
}

// ── SYNC ────────────────────────────────────────────────────────────────────
async function syncReqs() {
    showToast('Sincronizando con Jira...', '');
    try {
        const r = await fetch('/api/jira/requirements/sync', {credentials:'include'});
        const d = await r.json();
        if (d.success) { showToast(`✅ ${d.synced} requerimientos sincronizados`, 'success'); loadReqs(); }
        else showToast('Error: '+d.message, 'error');
    } catch(e) { showToast('Error de conexión', 'error'); }
}

// ── TAKE ────────────────────────────────────────────────────────────────────
async function takeReq(key) {
    try {
        const r = await fetch(`/api/jira/requirement/${key}/take`, {method:'PUT', credentials:'include'});
        const d = await r.json();
        if (d.success) { showToast(`✅ ${key} tomado`, 'success'); loadReqs(); }
        else showToast('Error: '+d.message, 'error');
    } catch(e) { showToast('Error de conexión', 'error'); }
}

// ── MODAL GESTIONAR ─────────────────────────────────────────────────────────
var _mgReqData = null;
function openManageReq(req) {
    _mgReqData = req;
    _mgReqKey  = req.key;
    document.getElementById('mgReqKey').textContent     = req.key;
    document.getElementById('mgReqSummary').textContent = req.summary || '—';
    document.getElementById('mgReqTipo').textContent    = req.tipo || 'Sin tipo';
    document.getElementById('mgReqPrio').className = `prio-badge prio-${req.priority||'P3'}`;
    document.getElementById('mgReqPrio').textContent = req.priority || 'P3';
    const istLabels = {abierto:'Abierto',asignado:'Asignado',en_progreso:'En progreso',pendiente_usuario:'Pend. usuario',resuelto:'Resuelto',cerrado:'Cerrado'};
    const ist = req.internal_status || 'abierto';
    document.getElementById('mgReqIst').className = `ist-badge ist-${ist}`;
    document.getElementById('mgReqIst').textContent = istLabels[ist] || ist;
    document.getElementById('mgReqAssigned').textContent = req.assigned_to_name ? `Asignado a: ${req.assigned_to_name}` : 'Sin técnico asignado';
    document.getElementById('mgReqJiraUrl').href = req.url || '#';
    document.getElementById('mgReqNote').value = req.resolution_note || '';
    document.getElementById('mgReqCloseComment').value = '';
    loadReqTechs();
    bootstrap.Modal.getOrCreateInstance(document.getElementById('modalManageReq')).show();
}

async function loadReqTechs() {
    try {
        const r = await fetch('/api/jira/technicians', {credentials:'include'});
        const d = await r.json();
        const sel = document.getElementById('mgReqTechSelect');
        sel.innerHTML = '<option value="">Seleccionar técnico...</option>' +
            (d.data||[]).map(t => `<option value="${t.id}" data-name="${t.full_name}">${t.full_name} (${t.role})</option>`).join('');
    } catch(e) {}
}

async function assignReqToTech() {
    const sel = document.getElementById('mgReqTechSelect');
    const techId = sel.value;
    const techName = sel.options[sel.selectedIndex]?.dataset?.name || '';
    if (!techId) { showToast('Selecciona un técnico', 'error'); return; }
    await patchReq({ assigned_to: techId, assigned_to_name: techName, internal_status: 'asignado' });
}

async function updateReqStatus(status) {
    await patchReq({ internal_status: status });
}

async function saveReqNote() {
    const note = document.getElementById('mgReqNote').value.trim();
    if (!note) { showToast('Escribe una nota de resolución', 'error'); return; }
    await patchReq({ resolution_note: note });
}

async function patchReq(body) {
    try {
        const r = await fetch(`/api/jira/requirement/${_mgReqKey}`, {
            method:'PATCH', credentials:'include',
            headers:{'Content-Type':'application/json'},
            body: JSON.stringify(body)
        });
        const d = await r.json();
        if (d.success) { showToast('✅ Actualizado', 'success'); loadReqs(); }
        else showToast('Error: '+d.message, 'error');
    } catch(e) { showToast('Error de conexión', 'error'); }
}

async function closeReq() {
    const comment = document.getElementById('mgReqCloseComment').value.trim();
    if (!comment) { showToast('Ingresa un comentario de cierre', 'error'); return; }
    try {
        const r = await fetch(`/api/jira/requirement/${_mgReqKey}/close`, {
            method:'POST', credentials:'include',
            headers:{'Content-Type':'application/json'},
            body: JSON.stringify({ comment })
        });
        const d = await r.json();
        if (d.success) {
            showToast(`✅ ${_mgReqKey} cerrado`, 'success');
            bootstrap.Modal.getInstance(document.getElementById('modalManageReq'))?.hide();
            loadReqs();
        } else showToast('Error: '+d.message, 'error');
    } catch(e) { showToast('Error de conexión', 'error'); }
}

// ── INDICADORES ─────────────────────────────────────────────────────────────
async function loadReqStats() {
    try {
        const r = await fetch('/api/jira/req-stats', {credentials:'include'});
        const d = await r.json();
        if (!d.success) return;
        document.getElementById('stTotal').textContent  = d.data.total;
        document.getElementById('stOpen').textContent   = d.data.open;
        document.getElementById('stClosed').textContent = d.data.closed;

        const renderList = (id, items, labelKey, countKey) => {
            const el = document.getElementById(id);
            if (!items?.length) { el.innerHTML = '<p style="font-size:12px;color:var(--text-muted);padding:12px 0;">Sin datos</p>'; return; }
            el.innerHTML = items.map(it => {
                const pct = d.data.total ? Math.round(it[countKey]/d.data.total*100) : 0;
                return `<div style="margin-bottom:10px;">
                    <div style="display:flex;justify-content:space-between;font-size:12px;margin-bottom:3px;">
                        <span style="font-weight:600;">${it[labelKey]}</span>
                        <span style="color:var(--text-muted);">${it[countKey]}</span>
                    </div>
                    <div style="height:6px;background:var(--border-soft);border-radius:3px;overflow:hidden;">
                        <div style="height:100%;background:var(--req-blue);border-radius:3px;width:${pct}%;transition:width .5s;"></div>
                    </div>
                </div>`;
            }).join('');
        };
        renderList('stByTipo', d.data.byTipo, 'tipo', 'n');
        renderList('stByTech', d.data.byTech, 'tech', 'n');
    } catch(e) {}
}

// ── ADMIN ───────────────────────────────────────────────────────────────────
var _allAdminUsers = [];
async function loadAdminUsers() {
    try {
        const r = await fetch('/api/auth/users', {credentials:'include'});
        const d = await r.json();
        _allAdminUsers = d.data || d.users || [];
        renderAdminUsers(_allAdminUsers);
    } catch(e) { document.getElementById('adminUserTable').innerHTML = '<p style="color:var(--text-muted);font-size:12px;padding:12px;">Error cargando usuarios</p>'; }
}
function filterAdminUsers(q) {
    const f = _allAdminUsers.filter(u => [u.full_name,u.email,u.username,u.role].join(' ').toLowerCase().includes(q.toLowerCase()));
    renderAdminUsers(f);
}
function renderAdminUsers(list) {
    const el = document.getElementById('adminUserTable');
    if (!list.length) { el.innerHTML = '<p style="color:var(--text-muted);font-size:12px;padding:12px;">Sin usuarios</p>'; return; }
    const roleColor = {administrador:'#dc2626',especialista:'#2563eb',visor:'#059669',usuario:'#6b7280'};
    el.innerHTML = `<table class="table" style="font-size:13px;"><thead><tr><th>Nombre</th><th>Email</th><th>Perfil</th><th>Acción</th></tr></thead><tbody>
    ${list.map(u=>`<tr>
        <td>${u.full_name||u.username}</td>
        <td style="color:var(--text-muted);">${u.email||'—'}</td>
        <td><span style="font-size:11px;font-weight:700;padding:2px 8px;border-radius:12px;background:${roleColor[u.role]||'#6b7280'}22;color:${roleColor[u.role]||'#6b7280'}">${u.role}</span></td>
        <td><select class="form-select-custom" style="font-size:11px;padding:4px 8px;width:auto;" onchange="changeUserRole(${u.id},this.value)">
            ${['usuario','visor','especialista','administrador'].map(r=>`<option value="${r}"${u.role===r?' selected':''}>${r}</option>`).join('')}
        </select></td>
    </tr>`).join('')}
    </tbody></table>`;
}
async function changeUserRole(userId, role) {
    try {
        const r = await fetch(`/api/auth/users/${userId}/role`, {
            method:'PATCH', credentials:'include',
            headers:{'Content-Type':'application/json'},
            body: JSON.stringify({role})
        });
        const d = await r.json();
        if (d.success) showToast('✅ Rol actualizado', 'success');
        else showToast('Error: '+(d.error||d.message), 'error');
    } catch(e) { showToast('Error de conexión', 'error'); }
}
async function createAdminUser() {
    const body = {
        full_name: document.getElementById('au_name').value.trim(),
        username:  document.getElementById('au_username').value.trim(),
        email:     document.getElementById('au_email').value.trim(),
        role:      document.getElementById('au_role').value,
        password:  document.getElementById('au_pass').value
    };
    if (!body.full_name || !body.email || !body.password)
        return showToast('Completa nombre, email y contraseña', 'error');
    try {
        const r = await fetch('/api/auth/register', {
            method:'POST', credentials:'include',
            headers:{'Content-Type':'application/json'},
            body: JSON.stringify(body)
        });
        const d = await r.json();
        if (d.success || d.id || d.userId) { showToast('✅ Usuario creado', 'success'); loadAdminUsers(); }
        else showToast('Error: '+(d.error||d.message), 'error');
    } catch(e) { showToast('Error de conexión', 'error'); }
}

// Pre-fill reporter from portal session + back button
(function prefillReporter(){
  const params = new URLSearchParams(window.location.search);
  const email = params.get('reporter') || localStorage.getItem('portal_user_email') || '';
  if(!email) return;
  const el = document.getElementById('rq_reporter');
  if(el && !el.value){
    el.value = email;
    if(typeof loadRqEmployeeInfo === 'function') loadRqEmployeeInfo(email);
  }
  // Show back-to-portal floating button
  const btn = document.createElement('a');
  btn.href = '/autogestion';
  btn.innerHTML = '<i class="bi bi-arrow-left-circle-fill"></i> Regresar al Portal';
  btn.style.cssText = 'position:fixed;bottom:22px;right:22px;z-index:9000;display:flex;align-items:center;gap:8px;background:#3b82f6;color:#fff;border-radius:30px;padding:10px 20px;font-size:13px;font-weight:700;text-decoration:none;box-shadow:0 4px 18px rgba(59,130,246,.4);transition:transform .2s,box-shadow .2s;';
  btn.onmouseenter = () => { btn.style.transform='translateY(-2px)'; btn.style.boxShadow='0 8px 24px rgba(59,130,246,.5)'; };
  btn.onmouseleave = () => { btn.style.transform=''; btn.style.boxShadow='0 4px 18px rgba(59,130,246,.4)'; };
  document.body.appendChild(btn);
})();
</script>
</body>
