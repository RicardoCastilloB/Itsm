# ============================================================================
# .env.example — Copia como .env y rellena con valores reales
# NUNCA commits el .env real
# ============================================================================

# ── APP ─────────────────────────────────────────────────────────────────────
NODE_ENV=production
PORT=8080
# URL pública de tu app (sin trailing slash). Azure: https://[nombre].azurewebsites.net
APP_URL=https://[nombre].azurewebsites.net
# Orígenes CORS permitidos (separados por coma — debe incluir APP_URL)
ALLOWED_ORIGINS=https://[nombre].azurewebsites.net

# ── BASE DE DATOS MYSQL ──────────────────────────────────────────────────────
EQUIPMENT_HOST=tu-servidor-mysql.com
EQUIPMENT_PORT=3306
EQUIPMENT_USER=tu_usuario
EQUIPMENT_PASSWORD=tu_password
EQUIPMENT_DATABASE=equipment_management
DB_POOL_MAX=10
DB_TIMEZONE=+00:00

# ── SEGURIDAD — SECRETOS ─────────────────────────────────────────────────────
# Mínimo 32 caracteres aleatorios en producción
# Generar con: node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_SECRET=CAMBIA_ESTO_MIN_32_CHARS_ALEATORIOS
JWT_REFRESH_SECRET=CAMBIA_ESTO_DIFERENTE_MIN_32_CHARS
SESSION_SECRET=CAMBIA_ESTO_OTRO_SECRETO_MIN_32_CHARS
JWT_EXPIRE=8h

# ── MICROSOFT AZURE AD (SSO) ─────────────────────────────────────────────────
MS_CLIENT_ID=xxxxxxxx-xxxx-xxxx-xxxx-xxxxxxxxxxxx
MS_TENANT_ID=xxxxxxxx-xxxx-xxxx-xxxx-xxxxxxxxxxxx
MS_CLIENT_SECRET=tu_client_secret_generado_en_azure
# Email de buzón de Microsoft para lectura de correos (opcional)
MS_USER_EMAIL=

# ── JIRA / ITSM (opcional — deshabilita si no usas Jira) ────────────────────
JIRA_HOST=https://tu-empresa.atlassian.net
JIRA_EMAIL=tu@email.com
JIRA_API_TOKEN=tu_token_de_jira
JIRA_SD_ID=
JIRA_RT_ID=
JIRA_REQ_PROJECT=
JIRA_REQ_ISSUETYPE=
JIRA_REQ_RT_ID=
JIRA_REQ_SD_ID=
JIRA_CMDB_COMPONENT_CONFIG=

# ── EMAIL / SMTP ─────────────────────────────────────────────────────────────
SMTP_HOST=smtp.office365.com
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=tu@email.com
SMTP_PASS=tu_password_smtp
SMTP_FROM=noreply@tuempresa.com
MAIL_FROM_NAME=IT Platform
MAIL_SENDER=tu@email.com

# ── IA — GROQ (opcional) ─────────────────────────────────────────────────────
GROQ_API_KEY=
GROQ_MODEL=llama3-8b-8192

# ── SLACK (opcional) ─────────────────────────────────────────────────────────
SLACK_BOT_TOKEN=

# ── OBSERVABILIDAD ───────────────────────────────────────────────────────────
# Token para proteger /metrics (dejar vacío = sin protección)
METRICS_TOKEN=

# ── RATE LIMITING ────────────────────────────────────────────────────────────
RATE_LIMIT_WINDOW=900000
RATE_LIMIT_MAX_REQUESTS=500

# ── TENANTS ──────────────────────────────────────────────────────────────────
DEFAULT_TENANT_SLUG=default
DEFAULT_TENANT_NAME=Empresa Principal

# ── SEEDERS (solo necesario al ejecutar seed inicial) ────────────────────────
ADMIN_USERNAME=admin
ADMIN_EMAIL=admin@tuempresa.com
ADMIN_PASSWORD=Admin1234!

# ── BACKUPS ──────────────────────────────────────────────────────────────────
BACKUP_DIR=/tmp/backups
RETENTION_DAYS=30
